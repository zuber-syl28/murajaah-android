{"narration":"soosi","surah":83,"ayahs":[{"number":1,"text":"وَيۡلٞ لِّلۡمُطَفِّفِينَ ١","juz":30,"page":587},{"number":2,"text":"اَ۬لَّذِينَ إِذَا اَ۪كۡتَالُواْ عَلَى اَ۬لنَّاسِ يَسۡتَوۡفُونَ ٢","juz":30,"page":587},{"number":3,"text":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ ٣","juz":30,"page":587},{"number":4,"text":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ ٤","juz":30,"page":587},{"number":5,"text":"لِيَوۡمٍ عَظِيمٖ ٥","juz":30,"page":588},{"number":6,"text":"يَوۡمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لۡعَٰلَمِينَ ٦","juz":30,"page":588},{"number":7,"text":"كَلَّا إِنَّ كِتَٰبَ  اَ۬لۡفُجّ۪ار لَّفِي سِجِّينٖ ٧","juz":30,"page":588},{"number":8,"text":"وَمَا أَدۡر۪ىٰكَ مَا سِجِّينٞ ٨","juz":30,"page":588},{"number":9,"text":"كِتَٰبٞ مَّرۡقُومٞ ٩","juz":30,"page":588},{"number":10,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٠","juz":30,"page":588},{"number":11,"text":"اَ۬لَّذِينَ يُكَذِّبُونَ بِيَوۡمِ اِ۬لدِّينِ ١١","juz":30,"page":588},{"number":12,"text":"وَمَا يُكَذِّب  بِّهِۦ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ ١٢","juz":30,"page":588},{"number":13,"text":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لۡأَوَّلِينَ ١٣","juz":30,"page":588},{"number":14,"text":"كَلَّاۖ بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ ١٤","juz":30,"page":588},{"number":15,"text":"كَلَّا إِنَّهُمۡ عَن رَّبِّهِمۡ  يَوۡمَئِذٖ لَّمَحۡجُوبُونَ ١٥","juz":30,"page":588},{"number":16,"text":"ثُمَّ إِنَّهُمۡ لَصَالُواْ اُ۬لۡجَحِيمِ ١٦","juz":30,"page":588},{"number":17,"text":"ثُمَّ يُقَالُ هَٰذَا  اَ۬لَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ١٧","juz":30,"page":588},{"number":18,"text":"۞ كَلَّا إِنَّ كِتَٰبَ اَ۬لۡأَبۡر۪ار لَّفِي عِلِّيِّينَ ١٨","juz":30,"page":588},{"number":19,"text":"وَمَا أَدۡر۪ىٰكَ مَا عِلِّيُّونَ ١٩","juz":30,"page":588},{"number":20,"text":"كِتَٰبٞ مَّرۡقُومٞ ٢٠","juz":30,"page":588},{"number":21,"text":"يَشۡهَدُهُ اُ۬لۡمُقَرَّبُونَ ٢١","juz":30,"page":588},{"number":22,"text":"إِنَّ اَ۬لۡأَبۡرَارَ لَفِي نَعِيمٍ ٢٢","juz":30,"page":588},{"number":23,"text":"عَلَى اَ۬لۡأَرَآئِكِ يَنظُرُونَ ٢٣","juz":30,"page":588},{"number":24,"text":"تَعۡرِف فِّي  وُجُوهِهِمۡ نَضۡرَةَ اَ۬لنَّعِيمِ ٢٤","juz":30,"page":588},{"number":25,"text":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ ٢٥","juz":30,"page":588},{"number":26,"text":"خِتَٰمُهُۥ  مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ اِ۬لۡمُتَنَٰفِسُونَ ٢٦","juz":30,"page":588},{"number":27,"text":"وَمِزَاجُهُۥ مِن  تَسۡنِيمٍ ٢٧","juz":30,"page":588},{"number":28,"text":"عَيۡنٗا يَشۡرَب بِّهَا اَ۬لۡمُقَرَّبُونَ ٢٨","juz":30,"page":588},{"number":29,"text":"إِنَّ اَ۬لَّذِينَ أَجۡرَمُواْ كَانُواْ  مِنَ اَ۬لَّذِينَ ءَامَنُواْ يَضۡحَكُونَ ٢٩","juz":30,"page":588},{"number":30,"text":"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ ٣٠","juz":30,"page":588},{"number":31,"text":"وَإِذَا اَ۪نقَلَبُواْ إِلَىٰ أَهۡلِهِمِ اِ۪نقَلَبُواْ فَٰكِهِينَ ٣١","juz":30,"page":588},{"number":32,"text":"وَإِذَا رَأَوۡهُمۡ قَالُواْ  إِنَّ هَٰؤُلَآءِ لَضَآلُّونَ ٣٢","juz":30,"page":588},{"number":33,"text":"وَمَا أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ ٣٣","juz":30,"page":588},{"number":34,"text":"فَاَلۡيَوۡمَ اَ۬لَّذِينَ ءَامَنُواْ مِنَ اَ۬لۡكُفّ۪ارِ يَضۡحَكُونَ ٣٤","juz":30,"page":589},{"number":35,"text":"عَلَى  اَ۬لۡأَرَآئِكِ يَنظُرُونَ ٣٥","juz":30,"page":589},{"number":36,"text":"هَلۡ ثُوِّبَ اَ۬لۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ ٣٦","juz":30,"page":589}]}