{"narration":"soosi","surah":75,"ayahs":[{"number":1,"text":"لَا أُقۡسِم بِيَوۡمِ اِ۬لۡقِيَٰمَةِ ١","juz":29,"page":577},{"number":2,"text":"وَلَا أُقۡسِم بِالنَّفۡسِ اِ۬للَّوَّامَةِ ٢","juz":29,"page":577},{"number":3,"text":"أَيَحۡسِبُ  اُ۬لۡإِنسَٰنُ أَلَّن نَّجۡمَع عِّظَامَهُۥ ٣","juz":29,"page":577},{"number":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥ ٤","juz":29,"page":577},{"number":5,"text":"بَلۡ  يُرِيدُ اُ۬لۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥","juz":29,"page":577},{"number":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ اُ۬لۡقِيَٰمَةِ ٦","juz":29,"page":577},{"number":7,"text":"فَإِذَا بَرِقَ  اَ۬لۡبَصَرُ ٧","juz":29,"page":577},{"number":8,"text":"وَخَسَفَ اَ۬لۡقَمَرُ ٨","juz":29,"page":577},{"number":9,"text":"وَجُمِعَ اَ۬لشَّمۡسُ وَاَلۡقَمَرُ ٩","juz":29,"page":577},{"number":10,"text":"يَقُولُ اُ۬لۡإِنسَٰنُ  يَوۡمَئِذٍ أَيۡنَ اَ۬لۡمَفَرُّ ١٠","juz":29,"page":577},{"number":11,"text":"كَلَّا لَا وَزَرَ ١١","juz":29,"page":577},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ اِ۬لۡمُسۡتَقَرُّ ١٢","juz":29,"page":577},{"number":13,"text":"يُنَبَّؤُاْ  اُ۬لۡإِنسَٰنُ يَوۡمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَ ١٣","juz":29,"page":577},{"number":14,"text":"بَلِ اِ۬لۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤","juz":29,"page":577},{"number":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥","juz":29,"page":577},{"number":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦ إِنَّ عَلَيۡنَا  جَمۡعَهُۥ وَقُرۡءَانَهُۥ ١٦","juz":29,"page":577},{"number":17,"text":"فَإِذَا قَرَانَٰهُ فَاَتَّبِعۡ قُرۡءَانَهُۥ ١٧","juz":29,"page":577},{"number":18,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٨","juz":29,"page":577},{"number":19,"text":"كَلَّا بَلۡ يُحِبُّونَ اَ۬لۡعَاجِلَةَ ١٩","juz":29,"page":578},{"number":20,"text":"وَيَذَرُونَ اَ۬لۡأٓخِرَةَ ٢٠","juz":29,"page":578},{"number":21,"text":"وُجُوهٞ يَوۡمَئِذٖ  نَّاضِرَةٌ ٢١","juz":29,"page":578},{"number":22,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ ٢٢","juz":29,"page":578},{"number":23,"text":"وَوُجُوهٞ يَوۡمَئِذِۢ بَاسِرَةٞ ٢٣","juz":29,"page":578},{"number":24,"text":"تَظُنُّ أَن يُفۡعَلَ  بِهَا فَاقِرَةٞ ٢٤","juz":29,"page":578},{"number":25,"text":"كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ ٢٥","juz":29,"page":578},{"number":26,"text":"وَقِيلَ مَن رَّاقٖ ٢٦","juz":29,"page":578},{"number":27,"text":"وَظَنَّ أَنَّهُ  اُ۬لۡفِرَاقُ ٢٧","juz":29,"page":578},{"number":28,"text":"وَاَلۡتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ ٢٨","juz":29,"page":578},{"number":29,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ اِ۬لۡمَسَاقُ ٢٩","juz":29,"page":578},{"number":30,"text":"فَلَا صَدَّقَ وَلَا صَلّۭيٰ ٣٠","juz":29,"page":578},{"number":31,"text":"وَلَٰكِن كَذَّبَ وَتَوَلّۭيٰ ٣١","juz":29,"page":578},{"number":32,"text":"ثُمَّ ذَهَبَ إِلَىٰ أَهۡلِهِۦ  يَتَمَطّۭيٰ ٣٢","juz":29,"page":578},{"number":33,"text":"أَوۡلَىٰ لَكَ فَأَوۡلۭيٰ ٣٣","juz":29,"page":578},{"number":34,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلۭيٰ ٣٤","juz":29,"page":578},{"number":35,"text":"أَيَحۡسِبُ  اُ۬لۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ٣٥","juz":29,"page":578},{"number":36,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ تُمۡنۭيٰ ٣٦","juz":29,"page":578},{"number":37,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوّۭيٰ ٣٧","juz":29,"page":578},{"number":38,"text":"فَجَعَلَ مِنۡهُ اُ۬لزَّوۡجَيۡنِ اِ۬لذَّكَرَ  وَاَلۡأُنثۭيٰ ٣٨","juz":29,"page":578},{"number":39,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَن يُحۡـِۧيَ اَ۬لۡمَوۡتۭيٰ ٣٩","juz":29,"page":578}]}