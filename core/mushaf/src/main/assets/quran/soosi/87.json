{"narration":"soosi","surah":87,"ayahs":[{"number":1,"text":"سَبِّحِ اِ۪سۡمَ رَبِّكَ اَ۬لۡأَعۡلَى ١","juz":30,"page":591},{"number":2,"text":"اَ۬لَّذِي خَلَقَ فَسَوّۭيٰ ٢","juz":30,"page":591},{"number":3,"text":"وَاَلَّذِي قَدَّرَ  فَهَدۭيٰ ٣","juz":30,"page":591},{"number":4,"text":"وَاَلَّذِي أَخۡرَجَ اَ۬لۡمَرۡعۭيٰ ٤","juz":30,"page":591},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحۡوۭيٰ ٥","juz":30,"page":591},{"number":6,"text":"سَنُقۡرِئُكَ فَلَا تَنسۭيٰ ٦","juz":30,"page":591},{"number":7,"text":"إِلَّا مَا شَآءَ اَ۬للَّهُۚ إِنَّهُۥ يَعۡلَمُ اُ۬لۡجَهۡرَ وَمَا يَخۡفۭيٰ ٧","juz":30,"page":591},{"number":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡر۪يٰ ٨","juz":30,"page":591},{"number":9,"text":"فَذَكِّرۡ إِن نَّفَعَتِ اِ۬لذِّكۡر۪يٰ ٩","juz":30,"page":591},{"number":10,"text":"سَيَذَّكَّرُ مَن يَخۡشۭيٰ ١٠","juz":30,"page":591},{"number":11,"text":"وَيَتَجَنَّبُهَا اَ۬لۡأَشۡقَى ١١","juz":30,"page":592},{"number":12,"text":"اَ۬لَّذِي يَصۡلَى اَ۬لنَّارَ اَ۬لۡكُبۡر۪يٰ ١٢","juz":30,"page":592},{"number":13,"text":"ثُمَّ لَا يَمُوتُ  فِيهَا وَلَا يَحۡيۭيٰ ١٣","juz":30,"page":592},{"number":14,"text":"قَدۡ أَفۡلَحَ مَن تَزَكّۭيٰ ١٤","juz":30,"page":592},{"number":15,"text":"وَذَكَرَ اَ۪سۡمَ رَبِّهِۦ فَصَلّۭيٰ ١٥","juz":30,"page":592},{"number":16,"text":"بَلۡ يُوثِرُونَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا ١٦","juz":30,"page":592},{"number":17,"text":"وَاَلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقۭيٰ ١٧","juz":30,"page":592},{"number":18,"text":"إِنَّ  هَٰذَا لَفِي اِ۬لصُّحُفِ اِ۬لۡأُولۭيٰ ١٨","juz":30,"page":592},{"number":19,"text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسۭيٰ ١٩","juz":30,"page":592}]}