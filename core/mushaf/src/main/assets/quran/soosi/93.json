{"narration":"soosi","surah":93,"ayahs":[{"number":1,"text":"وَاَلضُّحۭيٰ ١","juz":30,"page":596},{"number":2,"text":"وَاَلَّيۡلِ إِذَا سَجۭيٰ ٢","juz":30,"page":596},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلۭيٰ ٣","juz":30,"page":596},{"number":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ اَ۬لۡأُولۭيٰ ٤","juz":30,"page":596},{"number":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ  فَتَرۡضۭيٰ ٥","juz":30,"page":596},{"number":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوۭيٰ ٦","juz":30,"page":596},{"number":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدۭيٰ ٧","juz":30,"page":596},{"number":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنۭيٰ ٨","juz":30,"page":596},{"number":9,"text":"فَأَمَّا اَ۬لۡيَتِيمَ فَلَا تَقۡهَرۡ ٩","juz":30,"page":596},{"number":10,"text":"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنۡهَرۡ ١٠","juz":30,"page":596},{"number":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١","juz":30,"page":596}]}