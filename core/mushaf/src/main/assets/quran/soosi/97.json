{"narration":"soosi","surah":97,"ayahs":[{"number":1,"text":"إِنَّا أَنزَلۡنَٰهُ فِي لَيۡلَةِ اِ۬لۡقَدۡرِ ١","juz":30,"page":598},{"number":2,"text":"وَمَا أَدۡر۪ىٰكَ مَا لَيۡلَةُ اُ۬لۡقَدۡر ٢","juz":30,"page":598},{"number":3,"text":"لَّيۡلَةُ اُ۬لۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ ٣","juz":30,"page":598},{"number":4,"text":"تَنَزَّلُ اُ۬لۡمَلَٰٓئِكَةُ وَاَلرُّوحُ فِيهَا  بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ ٤","juz":30,"page":598},{"number":5,"text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ اِ۬لۡفَجۡرِ ٥","juz":30,"page":598}]}