{"narration":"soosi","surah":86,"ayahs":[{"number":1,"text":"وَاَلسَّمَآءِ وَاَلطَّارِقِ ١","juz":30,"page":591},{"number":2,"text":"وَمَا أَدۡر۪ىٰكَ مَا اَ۬لطَّارِقُ ٢","juz":30,"page":591},{"number":3,"text":"اُ۬لنَّجۡمُ اُ۬لثَّاقِبُ ٣","juz":30,"page":591},{"number":4,"text":"إِن كُلُّ نَفۡسٖ لَّمَا عَلَيۡهَا حَافِظٞ ٤","juz":30,"page":591},{"number":5,"text":"فَلۡيَنظُرِ اِ۬لۡإِنسَٰنُ مِمَّ خُلِقَ ٥","juz":30,"page":591},{"number":6,"text":"خُلِقَ مِن مَّآءٖ دَافِقٖ ٦","juz":30,"page":591},{"number":7,"text":"يَخۡرُجُ مِنۢ بَيۡنِ اِ۬لصُّلۡبِ وَاَلتَّرَآئِبِ ٧","juz":30,"page":591},{"number":8,"text":"إِنَّهُۥ  عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ٨","juz":30,"page":591},{"number":9,"text":"يَوۡمَ تُبۡلَى اَ۬لسَّرَآئِرُ ٩","juz":30,"page":591},{"number":10,"text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا  نَاصِرٖ ١٠","juz":30,"page":591},{"number":11,"text":"وَاَلسَّمَآءِ ذَاتِ اِ۬لرَّجۡعِ ١١","juz":30,"page":591},{"number":12,"text":"وَاَلۡأَرۡضِ ذَاتِ اِ۬لصَّدۡعِ ١٢","juz":30,"page":591},{"number":13,"text":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ ١٣","juz":30,"page":591},{"number":14,"text":"وَمَا هُوَ بِالۡهَزۡلِ ١٤","juz":30,"page":591},{"number":15,"text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا  وَأَكِيدُ كَيۡدٗا ١٥","juz":30,"page":591},{"number":16,"text":"فَمَهِّلِ اِ۬لۡكٰ۪فِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ١٦","juz":30,"page":591}]}