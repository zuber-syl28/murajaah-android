{"narration":"soosi","surah":111,"ayahs":[{"number":1,"text":"تَبَّتۡ يَدَا أَبِي لَهَبٖ وَتَبَّ ١","juz":30,"page":603},{"number":2,"text":"مَا أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ ٢","juz":30,"page":603},{"number":3,"text":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ ٣","juz":30,"page":603},{"number":4,"text":"وَاَمۡرَأَتُهُۥ حَمَّالَةُ اُ۬لۡحَطَبِ ٤","juz":30,"page":603},{"number":5,"text":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۢ ٥","juz":30,"page":603}]}