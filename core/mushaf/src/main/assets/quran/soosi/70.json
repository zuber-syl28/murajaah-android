{"narration":"soosi","surah":70,"ayahs":[{"number":1,"text":"سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١","juz":29,"page":568},{"number":2,"text":"لِّلۡكٰ۪فِرِينَ لَيۡسَ لَهُۥ دَافِعٞ ٢","juz":29,"page":568},{"number":3,"text":"مِّنَ اَ۬للَّهِ ذِي اِ۬لۡمَعَارِج ٣","juz":29,"page":568},{"number":4,"text":"تَّعۡرُجُ اُ۬لۡمَلَٰٓئِكَةُ وَاَلرُّوحُ إِلَيۡهِ فِي  يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ ٤","juz":29,"page":568},{"number":5,"text":"فَاَصۡبِرۡ صَبۡرٗا جَمِيلًا ٥","juz":29,"page":568},{"number":6,"text":"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا ٦","juz":29,"page":568},{"number":7,"text":"وَنَر۪ىٰهُ قَرِيبٗا ٧","juz":29,"page":568},{"number":8,"text":"يَوۡمَ تَكُونُ اُ۬لسَّمَآءُ  كَاَلۡمُهۡلِ ٨","juz":29,"page":568},{"number":9,"text":"وَتَكُونُ اُ۬لۡجِبَالُ كَاَلۡعِهۡنِ ٩","juz":29,"page":568},{"number":10,"text":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا ١٠","juz":29,"page":568},{"number":11,"text":"يُبَصَّرُونَهُمۡۚ يَوَدُّ اُ۬لۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۢ بِبَنِيهِ ١١","juz":29,"page":569},{"number":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢","juz":29,"page":569},{"number":13,"text":"وَفَصِيلَتِهِ اِ۬لَّتِي تُـٔۡوِيهِ ١٣","juz":29,"page":569},{"number":14,"text":"وَمَن فِي اِ۬لۡأَرۡضِ جَمِيعٗا  ثُمَّ يُنجِيهِ ١٤","juz":29,"page":569},{"number":15,"text":"كَلَّاۖ إِنَّهَا لَظۭيٰ ١٥","juz":29,"page":569},{"number":16,"text":"نَزَّاعَةٞ لِّلشَّوۭيٰ ١٦","juz":29,"page":569},{"number":17,"text":"تَدۡعُواْ مَنۡ أَدۡبَرَ  وَتَوَلّۭيٰ ١٧","juz":29,"page":569},{"number":18,"text":"وَجَمَعَ فَأَوۡعۭيٰ ١٨","juz":29,"page":569},{"number":19,"text":"إِنَّ اَ۬لۡإِنسَٰنَ خُلِقَ هَلُوعًا ١٩","juz":29,"page":569},{"number":20,"text":"إِذَا مَسَّهُ اُ۬لشَّرُّ  جَزُوعٗا ٢٠","juz":29,"page":569},{"number":21,"text":"وَإِذَا مَسَّهُ اُ۬لۡخَيۡرُ مَنُوعًا ٢١","juz":29,"page":569},{"number":22,"text":"إِلَّا اَ۬لۡمُصَلِّينَ ٢٢","juz":29,"page":569},{"number":23,"text":"اَ۬لَّذِينَ هُمۡ  عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ ٢٣","juz":29,"page":569},{"number":24,"text":"وَاَلَّذِينَ فِي أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ ٢٤","juz":29,"page":569},{"number":25,"text":"لِّلسَّآئِلِ  وَاَلۡمَحۡرُومِ ٢٥","juz":29,"page":569},{"number":26,"text":"وَاَلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ اِ۬لدِّينِ ٢٦","juz":29,"page":569},{"number":27,"text":"وَاَلَّذِينَ هُم مِّنۡ عَذَابِ  رَبِّهِم مُّشۡفِقُونَ ٢٧","juz":29,"page":569},{"number":28,"text":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَامُونٖ ٢٨","juz":29,"page":569},{"number":29,"text":"وَاَلَّذِينَ هُمۡ  لِفُرُوجِهِمۡ حَٰفِظُونَ ٢٩","juz":29,"page":569},{"number":30,"text":"إِلَّا عَلَىٰ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ  غَيۡرُ مَلُومِينَ ٣٠","juz":29,"page":569},{"number":31,"text":"فَمَنِ اِ۪بۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لۡعَادُونَ ٣١","juz":29,"page":569},{"number":32,"text":"وَاَلَّذِينَ  هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ ٣٢","juz":29,"page":569},{"number":33,"text":"وَاَلَّذِينَ هُم بِشَهَٰدَتِهِمۡ قَآئِمُونَ ٣٣","juz":29,"page":569},{"number":34,"text":"وَاَلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ ٣٤","juz":29,"page":569},{"number":35,"text":"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ ٣٥","juz":29,"page":569},{"number":36,"text":"فَمَالِ اِ۬لَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ ٣٦","juz":29,"page":569},{"number":37,"text":"عَنِ اِ۬لۡيَمِينِ وَعَنِ اِ۬لشِّمَالِ  عِزِينَ ٣٧","juz":29,"page":569},{"number":38,"text":"أَيَطۡمَعُ كُلُّ اُ۪مۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ ٣٨","juz":29,"page":569},{"number":39,"text":"كَلَّاۖ إِنَّا خَلَقۡنَٰهُم  مِّمَّا يَعۡلَمُونَ ٣٩","juz":29,"page":569},{"number":40,"text":"۞ فَلَا أُقۡسِم بِرَبِّ اِ۬لۡمَشَٰرِقِ وَاَلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠","juz":29,"page":569},{"number":41,"text":"عَلَىٰ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٤١","juz":29,"page":570},{"number":42,"text":"فَذَرۡهُمۡ  يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ اُ۬لَّذِي يُوعَدُونَ ٤٢","juz":29,"page":570},{"number":43,"text":"يَوۡمَ  يَخۡرُجُونَ مِنَ اَ۬لۡأَجۡدَاث سِّرَاعٗا كَأَنَّهُمۡ إِلَىٰ نَصۡبٖ يُوفِضُونَ ٤٣","juz":29,"page":570},{"number":44,"text":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ اَ۬لۡيَوۡمُ اُ۬لَّذِي كَانُواْ يُوعَدُونَ ٤٤","juz":29,"page":570}]}