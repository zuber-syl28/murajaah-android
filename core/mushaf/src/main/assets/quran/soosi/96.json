{"narration":"soosi","surah":96,"ayahs":[{"number":1,"text":"اِ۪قۡرَأۡ بِاسۡمِ رَبِّكَ اَ۬لَّذِي خَلَقَ ١","juz":30,"page":597},{"number":2,"text":"خَلَقَ اَ۬لۡإِنسَٰنَ مِنۡ عَلَقٍ ٢","juz":30,"page":597},{"number":3,"text":"اِ۪قۡرَأۡ  وَرَبُّكَ اَ۬لۡأَكۡرَمُ ٣","juz":30,"page":597},{"number":4,"text":"اُ۬لَّذِي عَلَّم بِالۡقَلَمِ ٤","juz":30,"page":597},{"number":5,"text":"عَلَّمَ اَ۬لۡإِنسَٰنَ  مَا لَمۡ يَعۡلَمۡ ٥","juz":30,"page":597},{"number":6,"text":"كَلَّا إِنَّ اَ۬لۡإِنسَٰنَ لَيَطۡغۭيٰ ٦","juz":30,"page":597},{"number":7,"text":"أَن رَّء۪اهُ اُ۪سۡتَغۡنۭيٰ ٧","juz":30,"page":597},{"number":8,"text":"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجۡعۭيٰ ٨","juz":30,"page":597},{"number":9,"text":"أَرَءَيۡتَ اَ۬لَّذِي يَنۡهۭيٰ ٩","juz":30,"page":597},{"number":10,"text":"عَبۡدًا  إِذَا صَلّۭيٰ ١٠","juz":30,"page":597},{"number":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى اَ۬لۡهُدۭيٰ ١١","juz":30,"page":597},{"number":12,"text":"أَوۡ أَمَرَ بِالتَّقۡوۭيٰ ١٢","juz":30,"page":597},{"number":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلّۭيٰ ١٣","juz":30,"page":598},{"number":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰ ١٤","juz":30,"page":598},{"number":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ ١٥","juz":30,"page":598},{"number":16,"text":"لَنَسۡفَعَۢا بِالنَّاصِيَةِ ١٦","juz":30,"page":598},{"number":17,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ١٧","juz":30,"page":598},{"number":18,"text":"فَلۡيَدۡعُ نَادِيَهُۥ ١٨","juz":30,"page":598},{"number":19,"text":"سَنَدۡعُ اُ۬لزَّبَانِيَةَ ١٩","juz":30,"page":598},{"number":20,"text":"كَلَّا لَا تُطِعۡهُ وَاَسۡجُدۡۤ وَاَقۡتَرِب۩ ٢٠","juz":30,"page":598}]}