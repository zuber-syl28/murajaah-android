{"narration":"qaloon","surah":112,"ayahs":[{"number":1,"text":"قُلْ هُوَ اَ۬للَّهُ أَحَدٌۖ ١","juz":30,"page":604},{"number":2,"text":"اِ۬للَّهُ اُ۬لصَّمَدُۖ ٢","juz":30,"page":604},{"number":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْۖ ٣","juz":30,"page":604},{"number":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُؤاً أَحَدُۢۖ ٤","juz":30,"page":604}]}