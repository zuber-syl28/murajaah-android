{"narration":"qaloon","surah":79,"ayahs":[{"number":1,"text":"وَالنَّٰزِعَٰتِ غَرْقاٗ ١","juz":30,"page":583},{"number":2,"text":"وَالنَّٰشِطَٰتِ نَشْطاٗ ٢","juz":30,"page":583},{"number":3,"text":"وَالسَّٰبِحَٰتِ سَبْحاٗ ٣","juz":30,"page":583},{"number":4,"text":"فَالسَّٰبِقَٰتِ سَبْقاٗ ٤","juz":30,"page":583},{"number":5,"text":"فَالْمُدَبِّرَٰتِ أَمْراٗ ٥","juz":30,"page":583},{"number":6,"text":"يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ ٦","juz":30,"page":583},{"number":7,"text":"تَتْبَعُهَا اَ۬لرَّادِفَةُۖ ٧","juz":30,"page":583},{"number":8,"text":"قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ ٨","juz":30,"page":583},{"number":9,"text":"أَبْصَٰرُهَا خَٰشِعَةٞۖ ٩","juz":30,"page":583},{"number":10,"text":"يَقُولُونَ أَٰ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ ١٠","juz":30,"page":583},{"number":11,"text":"إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ ١١","juz":30,"page":583},{"number":12,"text":"قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ ١٢","juz":30,"page":583},{"number":13,"text":"فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ ١٣","juz":30,"page":583},{"number":14,"text":"فَإِذَا هُم بِالسَّاهِرَةِۖ ١٤","juz":30,"page":583},{"number":15,"text":"هَلْ أَتَيٰكَ حَدِيثُ مُوسَىٰ ١٥","juz":30,"page":583},{"number":16,"text":"إِذْ نَادَيٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ ١٦","juz":30,"page":583},{"number":17,"text":"اَ۪ذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ١٧","juz":30,"page":584},{"number":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ ١٨","juz":30,"page":584},{"number":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰۖ ١٩","juz":30,"page":584},{"number":20,"text":"فَأَرَيٰهُ اُ۬لْأٓيَةَ اَ۬لْكُبْرَىٰ ٢٠","juz":30,"page":584},{"number":21,"text":"فَكَذَّبَ وَعَصَىٰ ٢١","juz":30,"page":584},{"number":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ ٢٢","juz":30,"page":584},{"number":23,"text":"فَحَشَرَ فَنَادَىٰ ٢٣","juz":30,"page":584},{"number":24,"text":"فَقَالَ أَنَا رَبُّكُمُ اُ۬لْأَعْلَىٰ ٢٤","juz":30,"page":584},{"number":25,"text":"فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لْأٓخِرَةِ وَالْأُولَىٰۖ ٢٥","juz":30,"page":584},{"number":26,"text":"إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْشَىٰۖ ٢٦","juz":30,"page":584},{"number":27,"text":"ءَٰا۬نتُمْ أَشَدُّ خَلْقاً أَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا ٢٧","juz":30,"page":584},{"number":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا ٢٨","juz":30,"page":584},{"number":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ ٢٩","juz":30,"page":584},{"number":30,"text":"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَا ٣٠","juz":30,"page":584},{"number":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا ٣١","juz":30,"page":584},{"number":32,"text":"وَالْجِبَالَ أَرْسَيٰهَا ٣٢","juz":30,"page":584},{"number":33,"text":"مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٣","juz":30,"page":584},{"number":34,"text":"فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْرَىٰ ٣٤","juz":30,"page":584},{"number":35,"text":"يَوْمَ يَتَذَكَّرُ اُ۬لْإِنسَٰنُ مَا سَعَىٰ ٣٥","juz":30,"page":584},{"number":36,"text":"وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّرَىٰۖ ٣٦","juz":30,"page":584},{"number":37,"text":"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا ٣٧","juz":30,"page":584},{"number":38,"text":"فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْوَىٰۖ ٣٨","juz":30,"page":584},{"number":39,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَوَىٰ ٣٩","juz":30,"page":584},{"number":40,"text":"فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْوَىٰۖ ٤٠","juz":30,"page":584},{"number":41,"text":"۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ ٤١","juz":30,"page":584},{"number":42,"text":"فِيمَ أَنتَ مِن ذِكْرَيٰهَاۖ ٤٢","juz":30,"page":584},{"number":43,"text":"إِلَىٰ رَبِّكَ مُنتَهَيٰهَاۖ ٤٣","juz":30,"page":584},{"number":44,"text":"إِنَّمَا أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ ٤٤","juz":30,"page":584},{"number":45,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُواْ إِلَّا عَشِيَّةً أَوْ ضُحَيٰهَاۖ ٤٥","juz":30,"page":584}]}