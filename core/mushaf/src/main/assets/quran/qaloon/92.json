{"narration":"qaloon","surah":92,"ayahs":[{"number":1,"text":"وَاليْلِ إِذَا يَغْشَىٰ ١","juz":30,"page":595},{"number":2,"text":"وَالنَّهَارِ إِذَا تَجَلَّىٰ ٢","juz":30,"page":595},{"number":3,"text":"وَمَا خَلَقَ اَ۬لذَّكَرَ وَالْأُنثَىٰ ٣","juz":30,"page":595},{"number":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰۖ ٤","juz":30,"page":595},{"number":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ ٥","juz":30,"page":595},{"number":6,"text":"وَصَدَّقَ بِالْحُسْنَىٰ ٦","juz":30,"page":595},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰۖ ٧","juz":30,"page":595},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنَىٰ ٨","juz":30,"page":595},{"number":9,"text":"وَكَذَّبَ بِالْحُسْنَىٰ ٩","juz":30,"page":595},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰۖ ١٠","juz":30,"page":596},{"number":11,"text":"وَمَا يُغْنِے عَنْهُ مَالُهُۥ إِذَا تَرَدَّىٰۖ ١١","juz":30,"page":596},{"number":12,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ ١٢","juz":30,"page":596},{"number":13,"text":"وَإِنَّ لَنَا لَلْأٓخِرَةَ وَالْأُولَىٰۖ ١٣","juz":30,"page":596},{"number":14,"text":"فَأَنذَرْتُكُمْ نَاراٗ تَلَظَّىٰ ١٤","juz":30,"page":596},{"number":15,"text":"لَا يَصْلَيٰهَا إِلَّا اَ۬لْأَشْقَى ١٥","juz":30,"page":596},{"number":16,"text":"اَ۬لذِے كَذَّبَ وَتَوَلَّىٰۖ ١٦","juz":30,"page":596},{"number":17,"text":"وَسَيُجَنَّبُهَا اَ۬لْأَتْقَى ١٧","juz":30,"page":596},{"number":18,"text":"اَ۬لذِے يُؤْتِے مَالَهُۥ يَتَزَكَّىٰۖ ١٨","juz":30,"page":596},{"number":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْزَىٰ ١٩","juz":30,"page":596},{"number":20,"text":"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لْأَعْلَىٰۖ ٢٠","juz":30,"page":596},{"number":21,"text":"وَلَسَوْفَ يَرْضَىٰۖ ٢١","juz":30,"page":596}]}