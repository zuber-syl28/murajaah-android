{"narration":"qaloon","surah":104,"ayahs":[{"number":1,"text":"وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١","juz":30,"page":601},{"number":2,"text":"اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ ٢","juz":30,"page":601},{"number":3,"text":"يَحْسِبُ أَنَّ مَالَهُۥ أَخْلَدَهُۥ ٣","juz":30,"page":601},{"number":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ ٤","juz":30,"page":601},{"number":5,"text":"وَمَا أَدْرَيٰكَ مَا اَ۬لْحُطَمَةُۖ ٥","juz":30,"page":601},{"number":6,"text":"نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ ٦","juz":30,"page":601},{"number":7,"text":"اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لْأَفْـِٕدَةِۖ ٧","juz":30,"page":601},{"number":8,"text":"إِنَّهَا عَلَيْهِم مُّوصَدَةٞ ٨","juz":30,"page":601},{"number":9,"text":"فِے عَمَدٖ مُّمَدَّدَةِۢۖ ٩","juz":30,"page":601}]}