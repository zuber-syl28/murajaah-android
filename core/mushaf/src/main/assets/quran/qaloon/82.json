{"narration":"qaloon","surah":82,"ayahs":[{"number":1,"text":"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ ١","juz":30,"page":587},{"number":2,"text":"وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ ٢","juz":30,"page":587},{"number":3,"text":"وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ ٣","juz":30,"page":587},{"number":4,"text":"وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ ٤","juz":30,"page":587},{"number":5,"text":"عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ ٥","juz":30,"page":587},{"number":6,"text":"يَٰأَيُّهَا اَ۬لْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ ٦","juz":30,"page":587},{"number":7,"text":"اِ۬لذِے خَلَقَكَ فَسَوَّيٰكَ فَعَدَّلَكَ ٧","juz":30,"page":587},{"number":8,"text":"فِے أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ ٨","juz":30,"page":587},{"number":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ ٩","juz":30,"page":587},{"number":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ ١٠","juz":30,"page":587},{"number":11,"text":"كِرَاماٗ كَٰتِبِينَ ١١","juz":30,"page":587},{"number":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَۖ ١٢","juz":30,"page":587},{"number":13,"text":"إِنَّ اَ۬لْأَبْرَارَ لَفِے نَعِيمٖۖ ١٣","juz":30,"page":587},{"number":14,"text":"وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ ١٤","juz":30,"page":587},{"number":15,"text":"يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ ١٥","juz":30,"page":587},{"number":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ ١٦","juz":30,"page":587},{"number":17,"text":"وَمَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِ ١٧","juz":30,"page":587},{"number":18,"text":"ثُمَّ مَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِۖ ١٨","juz":30,"page":587},{"number":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَئْاٗۖ وَالْأَمْرُ يَوْمَئِذٖ لِّلهِۖ ١٩","juz":30,"page":587}]}