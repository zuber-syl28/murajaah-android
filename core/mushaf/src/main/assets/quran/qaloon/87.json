{"narration":"qaloon","surah":87,"ayahs":[{"number":1,"text":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى ١","juz":30,"page":591},{"number":2,"text":"اَ۬لذِے خَلَقَ فَسَوَّىٰ ٢","juz":30,"page":591},{"number":3,"text":"وَالذِے قَدَّرَ فَهَدَىٰ ٣","juz":30,"page":591},{"number":4,"text":"وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ ٤","juz":30,"page":591},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ ٥","juz":30,"page":591},{"number":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰ ٦","juz":30,"page":591},{"number":7,"text":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ ٧","juz":30,"page":591},{"number":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ ٨","juz":30,"page":591},{"number":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ ٩","juz":30,"page":591},{"number":10,"text":"سَيَذَّكَّرُ مَنْ يَّخْشَىٰ ١٠","juz":30,"page":591},{"number":11,"text":"وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى ١١","juz":30,"page":592},{"number":12,"text":"اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ ١٢","juz":30,"page":592},{"number":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ ١٣","juz":30,"page":592},{"number":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ ١٤","juz":30,"page":592},{"number":15,"text":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ ١٥","juz":30,"page":592},{"number":16,"text":"بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا ١٦","juz":30,"page":592},{"number":17,"text":"وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ ١٧","juz":30,"page":592},{"number":18,"text":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ ١٨","juz":30,"page":592},{"number":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ ١٩","juz":30,"page":592}]}