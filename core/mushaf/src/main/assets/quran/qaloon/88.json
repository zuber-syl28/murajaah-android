{"narration":"qaloon","surah":88,"ayahs":[{"number":1,"text":"هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ ١","juz":30,"page":592},{"number":2,"text":"وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ ٢","juz":30,"page":592},{"number":3,"text":"عَامِلَةٞ نَّاصِبَةٞ ٣","juz":30,"page":592},{"number":4,"text":"تَصْلَىٰ نَاراً حَامِيَةٗ ٤","juz":30,"page":592},{"number":5,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٖۖ ٥","juz":30,"page":592},{"number":6,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦","juz":30,"page":592},{"number":7,"text":"لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ ٧","juz":30,"page":592},{"number":8,"text":"وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ ٨","juz":30,"page":592},{"number":9,"text":"لِّسَعْيِهَا رَاضِيَةٞ ٩","juz":30,"page":592},{"number":10,"text":"فِے جَنَّةٍ عَالِيَةٖ ١٠","juz":30,"page":592},{"number":11,"text":"لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ ١١","juz":30,"page":592},{"number":12,"text":"فِيهَا عَيْنٞ جَارِيَةٞۖ ١٢","juz":30,"page":592},{"number":13,"text":"فِيهَا سُرُرٞ مَّرْفُوعَةٞ ١٣","juz":30,"page":592},{"number":14,"text":"وَأَكْوَابٞ مَّوْضُوعَةٞ ١٤","juz":30,"page":592},{"number":15,"text":"وَنَمَارِقُ مَصْفُوفَةٞ ١٥","juz":30,"page":592},{"number":16,"text":"وَزَرَابِيُّ مَبْثُوثَةٌۖ ١٦","juz":30,"page":592},{"number":17,"text":"۞ أَفَلَا يَنظُرُونَ إِلَى اَ۬لْإِبِلِ كَيْفَ خُلِقَتْ ١٧","juz":30,"page":592},{"number":18,"text":"وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ ١٨","juz":30,"page":592},{"number":19,"text":"وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ ١٩","juz":30,"page":592},{"number":20,"text":"وَإِلَى اَ۬لْأَرْضِ كَيْفَ سُطِحَتْۖ ٢٠","juz":30,"page":592},{"number":21,"text":"فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٞۖ ٢١","juz":30,"page":592},{"number":22,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ ٢٢","juz":30,"page":592},{"number":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣","juz":30,"page":593},{"number":24,"text":"فَيُعَذِّبُهُ اُ۬للَّهُ اُ۬لْعَذَابَ اَ۬لْأَكْبَرَۖ ٢٤","juz":30,"page":593},{"number":25,"text":"إِنَّ إِلَيْنَا إِيَابَهُمْ ٢٥","juz":30,"page":593},{"number":26,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمۖ ٢٦","juz":30,"page":593}]}