{"narration":"qaloon","surah":1,"ayahs":[{"number":1,"text":"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ ١","juz":1,"page":1},{"number":2,"text":"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ ٢","juz":1,"page":1},{"number":3,"text":"مَلِكِ يَوْمِ اِ۬لدِّينِۖ ٣","juz":1,"page":1},{"number":4,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ ٤","juz":1,"page":1},{"number":5,"text":"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ ٥","juz":1,"page":1},{"number":6,"text":"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ ٦","juz":1,"page":1},{"number":7,"text":"غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ ٧","juz":1,"page":1}]}