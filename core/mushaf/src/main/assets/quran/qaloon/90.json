{"narration":"qaloon","surah":90,"ayahs":[{"number":1,"text":"لَا أُقْسِمُ بِهَٰذَا اَ۬لْبَلَدِ ١","juz":30,"page":594},{"number":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ ٢","juz":30,"page":594},{"number":3,"text":"وَوَالِدٖ وَمَا وَلَدَ ٣","juz":30,"page":594},{"number":4,"text":"لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے كَبَدٍۖ ٤","juz":30,"page":594},{"number":5,"text":"أَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ ٥","juz":30,"page":594},{"number":6,"text":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ ٦","juz":30,"page":594},{"number":7,"text":"أَيَحْسِبُ أَن لَّمْ يَرَهُۥ أَحَدٌۖ ٧","juz":30,"page":594},{"number":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ ٨","juz":30,"page":594},{"number":9,"text":"وَلِسَاناٗ وَشَفَتَيْنِ ٩","juz":30,"page":594},{"number":10,"text":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ ١٠","juz":30,"page":594},{"number":11,"text":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ ١١","juz":30,"page":594},{"number":12,"text":"وَمَا أَدْرَيٰكَ مَا اَ۬لْعَقَبَةُۖ ١٢","juz":30,"page":594},{"number":13,"text":"فَكُّ رَقَبَةٍ ١٣","juz":30,"page":594},{"number":14,"text":"أَوْ إِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ ١٤","juz":30,"page":594},{"number":15,"text":"يَتِيماٗ ذَا مَقْرَبَةٍ ١٥","juz":30,"page":594},{"number":16,"text":"أَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ ١٦","juz":30,"page":594},{"number":17,"text":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ ١٧","juz":30,"page":594},{"number":18,"text":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ ١٨","juz":30,"page":594},{"number":19,"text":"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١٩","juz":30,"page":595},{"number":20,"text":"عَلَيْهِمْ نَارٞ مُّوصَدَةُۢۖ ٢٠","juz":30,"page":595}]}