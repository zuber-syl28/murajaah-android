{"narration":"qumbul","surah":37,"ayahs":[{"number":1,"text":"وَٱلصَّٰٓفَّٰتِ صَفّٗا ١","juz":23,"page":446},{"number":2,"text":"فَٱلزَّٰجِرَٰتِ زَجۡرٗا ٢","juz":23,"page":446},{"number":3,"text":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا ٣","juz":23,"page":446},{"number":4,"text":"إِنَّ إِلَٰهَكُمُۥ لَوَٰحِدٞ ٤","juz":23,"page":446},{"number":5,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ ٥","juz":23,"page":446},{"number":6,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةِ ٱلۡكَوَاكِبِ ٦","juz":23,"page":446},{"number":7,"text":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ ٧","juz":23,"page":446},{"number":8,"text":"لَّا يَسۡمَعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ ٨","juz":23,"page":446},{"number":9,"text":"دُحُورٗاۖ وَلَهُمُۥ عَذَابٞ وَاصِبٌ ٩","juz":23,"page":446},{"number":10,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ ١٠","juz":23,"page":446},{"number":11,"text":"فَٱسۡتَفۡتِهِمُۥ أَهُمُۥ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَاۚ إِنَّا خَلَقۡنَٰهُمُۥ مِن طِينٖ لَّازِبِۭ ١١","juz":23,"page":446},{"number":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ ١٢","juz":23,"page":446},{"number":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ ١٣","juz":23,"page":446},{"number":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ ١٤","juz":23,"page":446},{"number":15,"text":"وَقَالُواْ إِنۡ هَٰذَا إِلَّا سِحۡرٞ مُّبِينٌ ١٥","juz":23,"page":446},{"number":16,"text":"أَ۟ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَ۟نَّا لَمَبۡعُوثُونَ ١٦","juz":23,"page":446},{"number":17,"text":"أَوَ ءَابَآؤُنَا ٱلۡأَوَّلُونَ ١٧","juz":23,"page":446},{"number":18,"text":"قُلۡ نَعَمۡ وَأَنتُمُۥ دَٰخِرُونَ ١٨","juz":23,"page":446},{"number":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمُۥ يَنظُرُونَ ١٩","juz":23,"page":446},{"number":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ ٢٠","juz":23,"page":446},{"number":21,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُمُۥ بِهِۦ تُكَذِّبُونَ ٢١","juz":23,"page":446},{"number":22,"text":"۞ ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمُۥ وَمَا كَانُواْ يَعۡبُدُونَ ٢٢","juz":23,"page":446},{"number":23,"text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمُۥ إِلَىٰ صِۜرَٰطِ ٱلۡجَحِيمِ ٢٣","juz":23,"page":446},{"number":24,"text":"وَقِفُوهُمُۥۖ إِنَّهُمُۥ مَسۡـُٔولُونَ ٢٤","juz":23,"page":446},{"number":25,"text":"مَا لَكُمُۥ لَا تَنَاصَرُونَ ٢٥","juz":23,"page":447},{"number":26,"text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦","juz":23,"page":447},{"number":27,"text":"وَأَقۡبَلَ بَعۡضُهُمُۥ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧","juz":23,"page":447},{"number":28,"text":"قَالُواْ إِنَّكُمُۥ كُنتُمُۥ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ٢٨","juz":23,"page":447},{"number":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩","juz":23,"page":447},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُمُۥ مِن سُلۡطَٰنِۭۖ بَلۡ كُنتُمُۥ قَوۡمٗا طَٰغِينَ ٣٠","juz":23,"page":447},{"number":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَاۖ إِنَّا لَذَآئِقُونَ ٣١","juz":23,"page":447},{"number":32,"text":"فَأَغۡوَيۡنَٰكُمُۥ إِنَّا كُنَّا غَٰوِينَ ٣٢","juz":23,"page":447},{"number":33,"text":"فَإِنَّهُمُۥ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ٣٣","juz":23,"page":447},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ٣٤","juz":23,"page":447},{"number":35,"text":"إِنَّهُمُۥ كَانُواْ إِذَا قِيلَ لَهُمُۥ لَا إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ٣٥","juz":23,"page":447},{"number":36,"text":"وَيَقُولُونَ أَى۪نَّا لَتَارِكُواْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ ٣٦","juz":23,"page":447},{"number":37,"text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ٣٧","juz":23,"page":447},{"number":38,"text":"إِنَّكُمُۥ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ٣٨","juz":23,"page":447},{"number":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمُۥ تَعۡمَلُونَ ٣٩","juz":23,"page":447},{"number":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلِصِينَ ٤٠","juz":23,"page":447},{"number":41,"text":"أُوْلَٰٓئِكَ لَهُمُۥ رِزۡقٞ مَّعۡلُومٞ ٤١","juz":23,"page":447},{"number":42,"text":"فَوَٰكِهُ وَهُمُۥ مُكۡرَمُون