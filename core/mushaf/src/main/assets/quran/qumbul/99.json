{"narration":"qumbul","surah":99,"ayahs":[{"number":1,"text":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا ١","juz":30,"page":599},{"number":2,"text":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا ٢","juz":30,"page":599},{"number":3,"text":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا ٣","juz":30,"page":599},{"number":4,"text":"يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا ٤","juz":30,"page":599},{"number":5,"text":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا ٥","juz":30,"page":599},{"number":6,"text":"يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا ٦","juz":30,"page":599},{"number":7,"text":"لِّيُرَوۡاْ أَعۡمَٰلَهُمُۥ ٧","juz":30,"page":599},{"number":8,"text":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ ٨","juz":30,"page":599},{"number":9,"text":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ ٩","juz":30,"page":599}]}