نَضَّاخَتَانِ ٦٥","juz":27,"page":533},{"number":66,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٦","juz":27,"page":533},{"number":67,"text":"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ ٦٧","juz":27,"page":533},{"number":68,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٨","juz":27,"page":533},{"number":69,"text":"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ ٦٩","juz":27,"page":534},{"number":70,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٠","juz":27,"page":534},{"number":71,"text":"حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ ٧١","juz":27,"page":534},{"number":72,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٢","juz":27,"page":534},{"number":73,"text":"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمُۥ وَلَا جَآنّٞ ٧٣","juz":27,"page":534},{"number":74,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٤","juz":27,"page":534},{"number":75,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ ٧٥","juz":27,"page":534},{"number":76,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٦","juz":27,"page":534},{"number":77,"text":"تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٧٧","juz":27,"page":534}]}