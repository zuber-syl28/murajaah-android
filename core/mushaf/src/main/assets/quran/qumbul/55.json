{"narration":"qumbul","surah":55,"ayahs":[{"number":1,"text":"ٱلرَّحۡمَٰنُ عَلَّمَ ٱلۡقُرَانَ ١","juz":27,"page":531},{"number":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ ٢","juz":27,"page":531},{"number":3,"text":"عَلَّمَهُ ٱلۡبَيَانَ ٣","juz":27,"page":531},{"number":4,"text":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ٤","juz":27,"page":531},{"number":5,"text":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ٥","juz":27,"page":531},{"number":6,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ٦","juz":27,"page":531},{"number":7,"text":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ٧","juz":27,"page":531},{"number":8,"text":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ٨","juz":27,"page":531},{"number":9,"text":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ٩","juz":27,"page":531},{"number":10,"text":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ١٠","juz":27,"page":531},{"number":11,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١١","juz":27,"page":531},{"number":12,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ١٢","juz":27,"page":531},{"number":13,"text":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ١٣","juz":27,"page":531},{"number":14,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٤","juz":27,"page":531},{"number":15,"text":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ١٥","juz":27,"page":531},{"number":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦","juz":27,"page":531},{"number":17,"text":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ١٧","juz":27,"page":532},{"number":18,"text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ١٨","juz":27,"page":532},{"number":19,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٩","juz":27,"page":532},{"number":20,"text":"يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ ٢٠","juz":27,"page":532},{"number":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢١","juz":27,"page":532},{"number":22,"text":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ ٢٢","juz":27,"page":532},{"number":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٣","juz":27,"page":532},{"number":24,"text":"كُلُّ مَنۡ عَلَيۡهَا فَانٖ ٢٤","juz":27,"page":532},{"number":25,"text":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٢٥","juz":27,"page":532},{"number":26,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٦","juz":27,"page":532},{"number":27,"text":"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ ٢٧","juz":27,"page":532},{"number":28,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٨","juz":27,"page":532},{"number":29,"text":"سَنَفۡرُغُ لَكُمُۥ أَيُّهَ ٱلثَّقَلَانِ ٢٩","juz":27,"page":532},{"number":30,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٠","juz":27,"page":532},{"number":31,"text":"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمُۥ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ ٣١","juz":27,"page":532},{"number":32,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٢","juz":27,"page":532},{"number":33,"text":"يُرۡسَلُ عَلَيۡكُمَا شِوَاظٞ مِّن نَّارٖ ٣٣","juz":27,"page":532},{"number":34,"text":"وَنُحَاسٖ فَلَا تَنتَصِرَانِ ٣٤","juz":27,"page":532},{"number":35,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٥","juz":27,"page":532},{"number":36,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ ٣٦","juz":27,"page":532},{"number":37,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٧","juz":27,"page":532},{"number":38,"text":"فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦ إِنسٞ وَلَا جَآنّٞ ٣٨","juz":27,"page":532},{"number":39,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٣٩","juz":27,"page":532},{"number":40,"text":"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمُۥ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ ٤٠","juz":27,"page":532},{"number":41,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٤١","juz":27,"page":533},{"number":42,"text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ ٤٢","juz":27,"page":533},{"number":43,"te