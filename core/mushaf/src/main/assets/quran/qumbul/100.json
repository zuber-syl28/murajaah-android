{"narration":"qumbul","surah":100,"ayahs":[{"number":1,"text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ١","juz":30,"page":599},{"number":2,"text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا ٢","juz":30,"page":599},{"number":3,"text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣","juz":30,"page":599},{"number":4,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤","juz":30,"page":599},{"number":5,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥","juz":30,"page":599},{"number":6,"text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦","juz":30,"page":600},{"number":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧","juz":30,"page":600},{"number":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨","juz":30,"page":600},{"number":9,"text":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩","juz":30,"page":600},{"number":10,"text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠","juz":30,"page":600},{"number":11,"text":"إِنَّ رَبَّهُمُۥ بِهِمُۥ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١","juz":30,"page":600}]}