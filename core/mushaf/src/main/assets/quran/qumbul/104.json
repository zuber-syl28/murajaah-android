{"narration":"qumbul","surah":104,"ayahs":[{"number":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١","juz":30,"page":601},{"number":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ٢","juz":30,"page":601},{"number":3,"text":"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ ٣","juz":30,"page":601},{"number":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ٤","juz":30,"page":601},{"number":5,"text":"وَمَا أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ٥","juz":30,"page":601},{"number":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ٦","juz":30,"page":601},{"number":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ٧","juz":30,"page":601},{"number":8,"text":"إِنَّهَا عَلَيۡهِمُۥ مُوصَدَةٞ ٨","juz":30,"page":601},{"number":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ ٩","juz":30,"page":601}]}