{"narration":"qumbul","surah":89,"ayahs":[{"number":1,"text":"وَٱلۡفَجۡرِ ١","juz":30,"page":593},{"number":2,"text":"وَلَيَالٍ عَشۡرٖ ٢","juz":30,"page":593},{"number":3,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣","juz":30,"page":593},{"number":4,"text":"وَٱلَّيۡلِ إِذَا يَسۡرِۦ ٤","juz":30,"page":593},{"number":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥","juz":30,"page":593},{"number":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦","juz":30,"page":593},{"number":7,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧","juz":30,"page":593},{"number":8,"text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨","juz":30,"page":593},{"number":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِۦ ٩","juz":30,"page":593},{"number":10,"text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠","juz":30,"page":593},{"number":11,"text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١","juz":30,"page":593},{"number":12,"text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢","juz":30,"page":593},{"number":13,"text":"فَصَبَّ عَلَيۡهِمُۥ رَبُّكَ سَوۡطَ عَذَابٍ ١٣","juz":30,"page":593},{"number":14,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤","juz":30,"page":593},{"number":15,"text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُۥ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ ١٥","juz":30,"page":593},{"number":16,"text":"فَيَقُولُ رَبِّيَ أَكۡرَمَنِ ١٦","juz":30,"page":593},{"number":17,"text":"وَأَمَّا إِذَا مَا ٱبۡتَلَىٰهُۥ فَقَدَرَ عَلَيۡهِۦ رِزۡقَهُۥ ١٧","juz":30,"page":593},{"number":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِ ١٨","juz":30,"page":593},{"number":19,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٩","juz":30,"page":593},{"number":20,"text":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٢٠","juz":30,"page":593},{"number":21,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ٢١","juz":30,"page":593},{"number":22,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٢","juz":30,"page":593},{"number":23,"text":"كَلَّاۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢٣","juz":30,"page":593},{"number":24,"text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٤","juz":30,"page":593},{"number":25,"text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَ ٢٥","juz":30,"page":594},{"number":26,"text":"يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٦","juz":30,"page":594},{"number":27,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٧","juz":30,"page":594},{"number":28,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدٞ ٢٨","juz":30,"page":594},{"number":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدٞ ٢٩","juz":30,"page":594},{"number":30,"text":"يَٰأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٣٠","juz":30,"page":594},{"number":31,"text":"ٱرۡجِعِي إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٣١","juz":30,"page":594},{"number":32,"text":"فَٱدۡخُلِي فِي عِبَٰدِي وَٱدۡخُلِي جَنَّتِي ٣٢","juz":30,"page":594}]}