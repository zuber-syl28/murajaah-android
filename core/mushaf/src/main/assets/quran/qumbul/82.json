{"narration":"qumbul","surah":82,"ayahs":[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ١","juz":30,"page":587},{"number":2,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ٢","juz":30,"page":587},{"number":3,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ٣","juz":30,"page":587},{"number":4,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ٤","juz":30,"page":587},{"number":5,"text":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ٥","juz":30,"page":587},{"number":6,"text":"يَٰأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ٦","juz":30,"page":587},{"number":7,"text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ ٧","juz":30,"page":587},{"number":8,"text":"فِي أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ٨","juz":30,"page":587},{"number":9,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ٩","juz":30,"page":587},{"number":10,"text":"وَإِنَّ عَلَيۡكُمُۥ لَحَٰفِظِينَ ١٠","juz":30,"page":587},{"number":11,"text":"كِرَامٗا كَٰتِبِينَ ١١","juz":30,"page":587},{"number":12,"text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ ١٢","juz":30,"page":587},{"number":13,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ١٣","juz":30,"page":587},{"number":14,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ١٤","juz":30,"page":587},{"number":15,"text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ١٥","juz":30,"page":587},{"number":16,"text":"وَمَا هُمُۥ عَنۡهَا بِغَآئِبِينَ ١٦","juz":30,"page":587},{"number":17,"text":"وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٧","juz":30,"page":587},{"number":18,"text":"ثُمَّ مَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ١٨","juz":30,"page":587},{"number":19,"text":"يَوۡمُ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ١٩","juz":30,"page":587}]}