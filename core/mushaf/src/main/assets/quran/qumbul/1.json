{"narration":"qumbul","surah":1,"ayahs":[{"number":1,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ١","juz":1,"page":1},{"number":2,"text":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ٢","juz":1,"page":1},{"number":3,"text":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ٣","juz":1,"page":1},{"number":4,"text":"مَلِكِ يَوۡمِ ٱلدِّينِ ٤","juz":1,"page":1},{"number":5,"text":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ٥","juz":1,"page":1},{"number":6,"text":"ٱهۡدِنَا ٱلصِّۜرَٰطَ ٱلۡمُسۡتَقِيمَ ٦","juz":1,"page":1},{"number":7,"text":"صِۜرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمُۥ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمُۥ وَلَا ٱلضَّآلِّينَ ٧","juz":1,"page":1}]}