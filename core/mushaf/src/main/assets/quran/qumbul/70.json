{"narration":"qumbul","surah":70,"ayahs":[{"number":1,"text":"سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١","juz":29,"page":568},{"number":2,"text":"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعٞ ٢","juz":29,"page":568},{"number":3,"text":"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ ٣","juz":29,"page":568},{"number":4,"text":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِۦ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ ٤","juz":29,"page":568},{"number":5,"text":"فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا ٥","juz":29,"page":568},{"number":6,"text":"إِنَّهُمُۥ يَرَوۡنَهُۥ بَعِيدٗا ٦","juz":29,"page":568},{"number":7,"text":"وَنَرَىٰهُۥ قَرِيبٗا ٧","juz":29,"page":568},{"number":8,"text":"يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ ٨","juz":29,"page":568},{"number":9,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٩","juz":29,"page":568},{"number":10,"text":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا ١٠","juz":29,"page":568},{"number":11,"text":"يُبَصَّرُونَهُمُۥۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِۦ ١١","juz":29,"page":569},{"number":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِۦ ١٢","juz":29,"page":569},{"number":13,"text":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِۦ ١٣","juz":29,"page":569},{"number":14,"text":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِۦ ١٤","juz":29,"page":569},{"number":15,"text":"كَلَّاۖ إِنَّهَا لَظَىٰ ١٥","juz":29,"page":569},{"number":16,"text":"نَزَّاعَةٞ لِّلشَّوَىٰ ١٦","juz":29,"page":569},{"number":17,"text":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ ١٧","juz":29,"page":569},{"number":18,"text":"وَجَمَعَ فَأَوۡعَىٰ ١٨","juz":29,"page":569},{"number":19,"text":"۞ إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا ١٩","juz":29,"page":569},{"number":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا ٢٠","juz":29,"page":569},{"number":21,"text":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا ٢١","juz":29,"page":569},{"number":22,"text":"إِلَّا ٱلۡمُصَلِّينَ ٢٢","juz":29,"page":569},{"number":23,"text":"ٱلَّذِينَ هُمُۥ عَلَىٰ صَلَاتِهِمُۥ دَآئِمُونَ ٢٣","juz":29,"page":569},{"number":24,"text":"وَٱلَّذِينَ فِي أَمۡوَٰلِهِمُۥ حَقّٞ مَّعۡلُومٞ ٢٤","juz":29,"page":569},{"number":25,"text":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ ٢٥","juz":29,"page":569},{"number":26,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ ٢٦","juz":29,"page":569},{"number":27,"text":"وَٱلَّذِينَ هُمُۥ مِنۡ عَذَابِ رَبِّهِمُۥ مُشۡفِقُونَ ٢٧","juz":29,"page":569},{"number":28,"text":"إِنَّ عَذَابَ رَبِّهِمُۥ غَيۡرُ مَأۡمُونٖ ٢٨","juz":29,"page":569},{"number":29,"text":"وَٱلَّذِينَ هُمُۥ لِفُرُوجِهِمُۥ حَٰفِظُونَ ٢٩","juz":29,"page":569},{"number":30,"text":"إِلَّا عَلَىٰ أَزۡوَٰجِهِمُۥ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمُۥ فَإِنَّهُمُۥ غَيۡرُ مَلُومِينَ ٣٠","juz":29,"page":569},{"number":31,"text":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ ٣١","juz":29,"page":569},{"number":32,"text":"وَٱلَّذِينَ هُمُۥ لِأَمَٰنَتِهِمُۥ وَعَهۡدِهِمُۥ رَٰعُونَ ٣٢","juz":29,"page":569},{"number":33,"text":"وَٱلَّذِينَ هُمُۥ بِشَهَٰدَتِهِمُۥ قَآئِمُونَ ٣٣","juz":29,"page":569},{"number":34,"text":"وَٱلَّذِينَ هُمُۥ عَلَىٰ صَلَاتِهِمُۥ يُحَافِظُونَ ٣٤","juz":29,"page":569},{"number":35,"text":"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ ٣٥","juz":29,"page":569},{"number":36,"text":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ ٣٦","juz":29,"page":569},{"number":37,"text":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ٣٧","juz":29,"page":569},{"number":38,"text":"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمُۥ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ ٣٨","juz":29,"page":569},{"number":39,"text":"كَلَّاۖ إِنَّا خَلَقۡنَٰهُمُۥ مِمَّا يَعۡلَمُونَ ٣٩","juz":29,"page":569},{"number":40,"text":"فَلَا أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠","juz":29,"page":569},{"number":41,"text":"عَلَىٰ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمُۥ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٤١","juz":29,"page":570},{"number":42,"text":"فَذَرۡهُمُۥ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ ٤٢","juz":29,"page":570},{"number":43,"text":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمُۥ إِلَىٰ نَصۡبٖ يُوفِضُونَ ٤٣","juz":29,"page":570},{"number":44,"text":"خَٰشِعَةً أَبۡصَٰرُهُمُۥ تَرۡهَقُهُمُۥ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ ٤٤","juz":29,"page":570}]}