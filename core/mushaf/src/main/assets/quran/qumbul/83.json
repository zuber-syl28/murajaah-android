{"narration":"qumbul","surah":83,"ayahs":[{"number":1,"text":"وَيۡلٞ لِّلۡمُطَفِّفِينَ ١","juz":30,"page":587},{"number":2,"text":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ ٢","juz":30,"page":587},{"number":3,"text":"وَإِذَا كَالُوهُمُۥ أَو وَّزَنُوهُمُۥ يُخۡسِرُونَ ٣","juz":30,"page":587},{"number":4,"text":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُمُۥ مَبۡعُوثُونَ ٤","juz":30,"page":587},{"number":5,"text":"لِيَوۡمٍ عَظِيمٖ ٥","juz":30,"page":588},{"number":6,"text":"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ ٦","juz":30,"page":588},{"number":7,"text":"كَلَّا إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ ٧","juz":30,"page":588},{"number":8,"text":"وَمَا أَدۡرَىٰكَ مَا سِجِّينٞ ٨","juz":30,"page":588},{"number":9,"text":"كِتَٰبٞ مَّرۡقُومٞ ٩","juz":30,"page":588},{"number":10,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١٠","juz":30,"page":588},{"number":11,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ ١١","juz":30,"page":588},{"number":12,"text":"وَمَا يُكَذِّبُ بِهِۦ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ ١٢","juz":30,"page":588},{"number":13,"text":"إِذَا تُتۡلَىٰ عَلَيۡهِۦ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ ١٣","juz":30,"page":588},{"number":14,"text":"كَلَّاۖ بَل رَّانَ عَلَىٰ قُلُوبِهِمُۥ مَا كَانُواْ يَكۡسِبُونَ ١٤","juz":30,"page":588},{"number":15,"text":"كَلَّا إِنَّهُمُۥ عَن رَّبِّهِمُۥ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ ١٥","juz":30,"page":588},{"number":16,"text":"ثُمَّ إِنَّهُمُۥ لَصَالُواْ ٱلۡجَحِيمِ ١٦","juz":30,"page":588},{"number":17,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُمُۥ بِهِۦ تُكَذِّبُونَ ١٧","juz":30,"page":588},{"number":18,"text":"كَلَّا إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ ١٨","juz":30,"page":588},{"number":19,"text":"وَمَا أَدۡرَىٰكَ مَا عِلِّيُّونَ ١٩","juz":30,"page":588},{"number":20,"text":"كِتَٰبٞ مَّرۡقُومٞ ٢٠","juz":30,"page":588},{"number":21,"text":"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ ٢١","juz":30,"page":588},{"number":22,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ ٢٢","juz":30,"page":588},{"number":23,"text":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٢٣","juz":30,"page":588},{"number":24,"text":"تَعۡرِفُ فِي وُجُوهِهِمُۥ نَضۡرَةَ ٱلنَّعِيمِ ٢٤","juz":30,"page":588},{"number":25,"text":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ ٢٥","juz":30,"page":588},{"number":26,"text":"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ ٢٦","juz":30,"page":588},{"number":27,"text":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ ٢٧","juz":30,"page":588},{"number":28,"text":"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ ٢٨","juz":30,"page":588},{"number":29,"text":"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ ٢٩","juz":30,"page":588},{"number":30,"text":"وَإِذَا مَرُّواْ بِهِمُۥ يَتَغَامَزُونَ ٣٠","juz":30,"page":588},{"number":31,"text":"وَإِذَا ٱنقَلَبُواْ إِلَىٰ أَهۡلِهِمُ ٱنقَلَبُواْ فَٰكِهِينَ ٣١","juz":30,"page":588},{"number":32,"text":"وَإِذَا رَأَوۡهُمُۥ قَالُواْ إِنَّ هَٰؤُلَآءِ لَضَآلُّونَ ٣٢","juz":30,"page":588},{"number":33,"text":"وَمَا أُرۡسِلُواْ عَلَيۡهِمُۥ حَٰفِظِينَ ٣٣","juz":30,"page":588},{"number":34,"text":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ ٣٤","juz":30,"page":589},{"number":35,"text":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ ٣٥","juz":30,"page":589},{"number":36,"text":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ ٣٦","juz":30,"page":589}]}