{"narration":"qumbul","surah":105,"ayahs":[{"number":1,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ ١","juz":30,"page":601},{"number":2,"text":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمُۥ فِي تَضۡلِيلٖ ٢","juz":30,"page":601},{"number":3,"text":"وَأَرۡسَلَ عَلَيۡهِمُۥ طَيۡرًا أَبَابِيلَ ٣","juz":30,"page":601},{"number":4,"text":"تَرۡمِيهِمُۥ بِحِجَارَةٖ مِّن سِجِّيلٖ ٤","juz":30,"page":601},{"number":5,"text":"فَجَعَلَهُمُۥ كَعَصۡفٖ مَّأۡكُولِۭ ٥","juz":30,"page":601}]}