{"narration":"doori","surah":101,"ayahs":[{"number":1,"text":"اِ۬لۡقَارِعَةُ مَا اَ۬لۡقَارِعَةُ ١","juz":30,"page":600},{"number":2,"text":"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡقَارِعَةُ ٢","juz":30,"page":600},{"number":3,"text":"يَوۡمَ يَكُونُ اُ۬لنَّاسُ كَاَلۡفَرَاشِ اِ۬لۡمَبۡثُوثِ ٣","juz":30,"page":600},{"number":4,"text":"وَتَكُونُ اُ۬لۡجِبَالُ كَاَلۡعِهۡنِ اِ۬لۡمَنفُوشِ ٤","juz":30,"page":600},{"number":5,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ٥","juz":30,"page":600},{"number":6,"text":"فَهۡوَ فِي عِيشَةٖ رَّاضِيَةٖ ٦","juz":30,"page":600},{"number":7,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ٧","juz":30,"page":600},{"number":8,"text":"فَأُمُّهُۥ هَاوِيَةٞ ٨","juz":30,"page":600},{"number":9,"text":"وَمَآ أَدۡر۪ىٰكَ مَا هِيَهۡ ٩","juz":30,"page":600},{"number":10,"text":"نَارٌ حَامِيَةُۢ ١٠","juz":30,"page":600}]}