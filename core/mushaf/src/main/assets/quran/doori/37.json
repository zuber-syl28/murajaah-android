{"narration":"doori","surah":37,"ayahs":[{"number":1,"text":"وَاَلصَّٰٓفَّٰتِ صَفّٗا ١","juz":23,"page":446},{"number":2,"text":"فَاَلزَّٰجِرَٰتِ زَجۡرٗا ٢","juz":23,"page":446},{"number":3,"text":"فَاَلتَّٰلِيَٰتِ ذِكۡرًا ٣","juz":23,"page":446},{"number":4,"text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ ٤","juz":23,"page":446},{"number":5,"text":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ اُ۬لۡمَشَٰرِقِ ٥","juz":23,"page":446},{"number":6,"text":"إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنۡيۭا بِزِينَةِ اِ۬لۡكَوَاكِبِ ٦","juz":23,"page":446},{"number":7,"text":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ ٧","juz":23,"page":446},{"number":8,"text":"لَّا يَسۡمَعُونَ إِلَى اَ۬لۡمَلَإِ اِ۬لۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ ٨","juz":23,"page":446},{"number":9,"text":"دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ ٩","juz":23,"page":446},{"number":10,"text":"إِلَّا مَنۡ خَطِفَ اَ۬لۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ ١٠","juz":23,"page":446},{"number":11,"text":"فَاَسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۢ ١١","juz":23,"page":446},{"number":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ ١٢","juz":23,"page":446},{"number":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ ١٣","juz":23,"page":446},{"number":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ ١٤","juz":23,"page":446},{"number":15,"text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ ١٥","juz":23,"page":446},{"number":16,"text":"أَٰ۟ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَٰ۟نَّا لَمَبۡعُوثُونَ ١٦","juz":23,"page":446},{"number":17,"text":"أَوَ ءَابَآؤُنَا اَ۬لۡأَوَّلُونَ ١٧","juz":23,"page":446},{"number":18,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ ١٨","juz":23,"page":446},{"number":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ ١٩","juz":23,"page":446},{"number":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ اُ۬لدِّينِ ٢٠","juz":23,"page":446},{"number":21,"text":"هَٰذَا يَوۡمُ اُ۬لۡفَصۡلِ اِ۬لَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ٢١","juz":23,"page":446},{"number":22,"text":"۞ اَ۟حۡشُرُواْ اُ۬لَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ ٢٢","juz":23,"page":446},{"number":23,"text":"مِن دُونِ اِ۬للَّهِ فَاَهۡدُوهُمۡ إِلَىٰ صِرَٰطِ اِ۬لۡجَحِيمِ ٢٣","juz":23,"page":446},{"number":24,"text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ ٢٤","juz":23,"page":446},{"number":25,"text":"مَا لَكُمۡ لَا تَنَاصَرُونَ ٢٥","juz":23,"page":447},{"number":26,"text":"بَلۡ هُمُ اُ۬لۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦","juz":23,"page":447},{"number":27,"text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧","juz":23,"page":447},{"number":28,"text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ اِ۬لۡيَمِينِ ٢٨","juz":23,"page":447},{"number":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩","juz":23,"page":447},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۢۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ ٣٠","juz":23,"page":447},{"number":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ٣١","juz":23,"page":447},{"number":32,"text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ٣٢","juz":23,"page":447},{"number":33,"text":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي اِ۬لۡعَذَابِ مُشۡتَرِكُونَ ٣٣","juz":23,"page":447},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِينَ ٣٤","juz":23,"page":447},{"number":35,"text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسۡتَكۡبِرُونَ ٣٥","juz":23,"page":447},{"number":36,"text":"وَيَقُولُونَ أَٰى۪نَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۢ ٣٦","juz":23,"page":447},{"number":37,"text":"بَلۡ جَآءَ بِالۡحَقِّ وَصَدَّقَ اَ۬لۡمُرۡسَلِينَ ٣٧","juz":23,"page":447},{"number":38,"text":"إِنَّكُمۡ لَذَآئِقُواْ اُ۬لۡعَذَابِ اِ۬لۡأَلِيمِ ٣٨","juz":23,"page":447},{"number":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ٣٩","juz":23,"page":447},{"number":40,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لۡمُخۡلِصِينَ ٤٠","juz":23,"page":447},{"number":41,"text":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ ٤١","juz":23,"page":447},{"number":42,"text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ٤٢","juz":23,"page":447},{"number":43,"text":"فِي جَنَّٰتِ اِ۬لنَّعِيمِ ٤٣","juz":23,"page":447},{"number":44,"text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ ٤٤","juz":23,"page":447},{"number":45,"text":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۢ ٤٥","juz":23,"page":447},{"number":46,"text":"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦","juz":23,"page":447},{"number":47,"text":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ٤٧","juz":23,"page":447},{"number":48,"text":"۞ وَعِندَهُمۡ قَٰصِرَٰتُ اُ۬لطَّرۡفِ عِينٞ ٤٨","juz":23,"page":447},{"number":49,"text":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ ٤٩","juz":23,"page":447},{"number":50,"text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٥٠","juz":23,"page":447},{"number":51,"text":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ ٥١","juz":23,"page":447},{"number":52,"text":"يَقُولُ أَٰ۟نَّكَ لَمِنَ اَ۬لۡمُصَدِّقِينَ ٥٢","juz":23,"page":448},{"number":53,"text":"أَٰ۟ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَٰ۟نَّا لَمَدِينُونَ ٥٣","juz":23,"page":448},{"number":54,"text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ٥٤","juz":23,"page":448},{"number":55,"text":"فَاَطَّلَعَ فَرَء۪اهُ فِي سَوَآءِ اِ۬لۡجَحِيمِ ٥٥","juz":23,"page":448},{"number":56,"text":"قَالَ تَاَللَّهِ إِن كِدتَّ لَتُرۡدِينِ ٥٦","juz":23,"page":448},{"number":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ اَ۬لۡمُحۡضَرِينَ ٥٧","juz":23,"page":448},{"number":58,"text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ ٥٨","juz":23,"page":448},{"number":59,"text":"إِلَّا مَوۡتَتَنَا اَ۬لۡأُولۭيٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ٥٩","juz":23,"page":448},{"number":60,"text":"إِنَّ هَٰذَا لَهۡوَ اَ۬لۡفَوۡزُ اُ۬لۡعَظِيمُ ٦٠","juz":23,"page":448},{"number":61,"text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ اِ۬لۡعَٰمِلُونَ ٦١","juz":23,"page":448},{"number":62,"text":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ اُ۬لزَّقُّومِ ٦٢","juz":23,"page":448},{"number":63,"text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ ٦٣","juz":23,"page":448},{"number":64,"text":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ ف