{"narration":"doori","surah":55,"ayahs":[{"number":1,"text":"اِ۬لرَّحۡمَٰنُ عَلَّمَ اَ۬لۡقُرۡءَانَ ١","juz":27,"page":531},{"number":2,"text":"خَلَقَ اَ۬لۡإِنسَٰنَ عَلَّمَهُ اُ۬لۡبَيَانَ ٢","juz":27,"page":531},{"number":3,"text":"اَ۬لشَّمۡسُ وَاَلۡقَمَرُ بِحُسۡبَانٖ ٣","juz":27,"page":531},{"number":4,"text":"وَاَلنَّجۡمُ وَاَلشَّجَرُ يَسۡجُدَانِ ٤","juz":27,"page":531},{"number":5,"text":"وَاَلسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لۡمِيزَانَ ٥","juz":27,"page":531},{"number":6,"text":"أَلَّا تَطۡغَوۡاْ فِي اِ۬لۡمِيزَانِ ٦","juz":27,"page":531},{"number":7,"text":"وَأَقِيمُواْ اُ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ اُ۬لۡمِيزَانَ ٧","juz":27,"page":531},{"number":8,"text":"وَاَلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ٨","juz":27,"page":531},{"number":9,"text":"فِيهَا فَٰكِهَةٞ وَاَلنَّخۡلُ ذَاتُ اُ۬لۡأَكۡمَامِ ٩","juz":27,"page":531},{"number":10,"text":"وَاَلۡحَبُّ ذُو اُ۬لۡعَصۡفِ وَاَلرَّيۡحَانُ ١٠","juz":27,"page":531},{"number":11,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١١","juz":27,"page":531},{"number":12,"text":"خَلَقَ اَ۬لۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَاَلۡفَخّ۪ارِ ١٢","juz":27,"page":531},{"number":13,"text":"وَخَلَقَ اَ۬لۡجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖ ١٣","juz":27,"page":531},{"number":14,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٤","juz":27,"page":531},{"number":15,"text":"رَبُّ اُ۬لۡمَشۡرِقَيۡنِ وَرَبُّ اُ۬لۡمَغۡرِبَيۡنِ ١٥","juz":27,"page":531},{"number":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦","juz":27,"page":531},{"number":17,"text":"مَرَجَ اَ۬لۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ١٧","juz":27,"page":532},{"number":18,"text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ١٨","juz":27,"page":532},{"number":19,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٩","juz":27,"page":532},{"number":20,"text":"يُخۡرَجُ مِنۡهُمَا اَ۬للُّؤۡلُؤُ وَاَلۡمَرۡجَانُ ٢٠","juz":27,"page":532},{"number":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢١","juz":27,"page":532},{"number":22,"text":"وَلَهُ اُ۬لۡجَوَارِ اِ۬لۡمُنشَـَٔاتُ فِي اِ۬لۡبَحۡرِ كَاَلۡ