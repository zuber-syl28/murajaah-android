{"narration":"doori","surah":107,"ayahs":[{"number":1,"text":"أَرَءَيۡتَ اَ۬لَّذِي يُكَذِّبُ بِالدِّينِ ١","juz":30,"page":602},{"number":2,"text":"فَذَٰلِكَ اَ۬لَّذِي يَدُعُّ اُ۬لۡيَتِيمَ ٢","juz":30,"page":602},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لۡمِسۡكِينِ ٣","juz":30,"page":602},{"number":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤","juz":30,"page":602},{"number":5,"text":"اَ۬لَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥","juz":30,"page":602},{"number":6,"text":"اَ۬لَّذِينَ هُمۡ يُرَآءُونَ وَيَمۡنَعُونَ اَ۬لۡمَاعُونَ ٦","juz":30,"page":602}]}