{"narration":"doori","surah":94,"ayahs":[{"number":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١","juz":30,"page":596},{"number":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢","juz":30,"page":596},{"number":3,"text":"اَ۬لَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣","juz":30,"page":597},{"number":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤","juz":30,"page":597},{"number":5,"text":"فَإِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرًا ٥","juz":30,"page":597},{"number":6,"text":"إِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرٗا ٦","juz":30,"page":597},{"number":7,"text":"فَإِذَا فَرَغۡتَ فَاَنصَبۡ ٧","juz":30,"page":597},{"number":8,"text":"وَإِلَىٰ رَبِّكَ فَاَرۡغَب ٨","juz":30,"page":597}]}