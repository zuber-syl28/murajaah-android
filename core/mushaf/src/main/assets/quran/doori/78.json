{"narration":"doori","surah":78,"ayahs":[{"number":1,"text":"عَمَّ يَتَسَآءَلُونَ ١","juz":30,"page":582},{"number":2,"text":"عَنِ اِ۬لنَّبَإِ اِ۬لۡعَظِيمِ ٢","juz":30,"page":582},{"number":3,"text":"اِ۬لَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ٣","juz":30,"page":582},{"number":4,"text":"كَلَّا سَيَعۡلَمُونَ ٤","juz":30,"page":582},{"number":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ ٥","juz":30,"page":582},{"number":6,"text":"أَلَمۡ نَجۡعَلِ اِ۬لۡأَرۡضَ مِهَٰدٗا ٦","juz":30,"page":582},{"number":7,"text":"وَاَلۡجِبَالَ أَوۡتَادٗا ٧","juz":30,"page":582},{"number":8,"text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ٨","juz":30,"page":582},{"number":9,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ٩","juz":30,"page":582},{"number":10,"text":"وَجَعَلۡنَا اَ۬لَّيۡلَ لِبَاسٗا ١٠","juz":30,"page":582},{"number":11,"text":"وَجَعَلۡنَا اَ۬لنَّهَارَ مَعَاشٗا ١١","juz":30,"page":582},{"number":12,"text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ١٢","juz":30,"page":582},{"number":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣","juz":30,"page":582},{"number":14,"text":"وَأَنزَلۡنَا مِنَ اَ۬لۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤","juz":30,"page":582},{"number":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥","juz":30,"page":582},{"number":16,"text":"وَجَنَّٰتٍ أَلۡفَافًا ١٦","juz":30,"page":582},{"number":17,"text":"إِنَّ يَوۡمَ اَ۬لۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧","juz":30,"page":582},{"number":18,"text":"يَوۡمَ يُنفَخُ فِي اِ۬لصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨","juz":30,"page":582},{"number":19,"text":"وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩","juz":30,"page":582},{"number":20,"text":"وَسُيِّرَتِ اِ۬لۡجِبَالُ فَكَانَت سَّرَابًا ٢٠","juz":30,"page":582},{"number":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١","juz":30,"page":582},{"number":22,"text":"لِّلطَّٰغِينَ مَـَٔابٗا ٢٢","juz":30,"page":582},{"number":23,"text":"لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ٢٣","juz":30,"page":582},{"number":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤","juz":30,"page":582},{"number":25,"text":"إِلَّا حَمِيمٗا وَغَسَاقٗا ٢٥","juz":30,"page":582},{"number":26,"text":"جَزَآءٗ وِفَاقًا ٢٦","juz":30,"page":582},{"number":27,"text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧","juz":30,"page":582},{"number":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨","juz":30,"page":582},{"number":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ٢٩","juz":30,"page":582},{"number":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ٣٠","juz":30,"page":582},{"number":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١","juz":30,"page":583},{"number":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢","juz":30,"page":583},{"number":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا ٣٣","juz":30,"page":583},{"number":34,"text":"وَكَأۡسٗا دِهَاقٗا ٣٤","juz":30,"page":583},{"number":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥","juz":30,"page":583},{"number":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦","juz":30,"page":583},{"number":37,"text":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِ وَمَا بَيۡنَهُمَا اَ۬لرَّحۡمَٰنُۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ٣٧","juz":30,"page":583},{"number":38,"text":"يَوۡمَ يَقُومُ اُ۬لرُّوحُ وَاَلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ اُ۬لرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨","juz":30,"page":583},{"number":39,"text":"ذَٰلِكَ اَ۬لۡيَوۡمُ اُ۬لۡحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩","juz":30,"page":583},{"number":40,"text":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ اُ۬لۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ اُ۬لۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤٠","juz":30,"page":583}]}