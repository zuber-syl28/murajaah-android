{"narration":"doori","surah":114,"ayahs":[{"number":1,"text":"قُلۡ أَعُوذُ بِرَبِّ اِ۬لنّ۪اسِ ١","juz":30,"page":604},{"number":2,"text":"مَلِكِ اِ۬لنّ۪اسِ ٢","juz":30,"page":604},{"number":3,"text":"إِلَٰهِ اِ۬لنّ۪اسِ ٣","juz":30,"page":604},{"number":4,"text":"مِن شَرِّ اِ۬لۡوَسۡوَاسِ اِ۬لۡخَنَّاسِ ٤","juz":30,"page":604},{"number":5,"text":"اِ۬لَّذِي يُوَسۡوِسُ فِي صُدُورِ اِ۬لنّ۪اسِ ٥","juz":30,"page":604},{"number":6,"text":"مِنَ اَ۬لۡجِنَّةِ وَاَلنّ۪اسِ ٦","juz":30,"page":604}]}