{"narration":"bazzi","surah":75,"ayahs":[{"number":1,"text":"لَأُاْقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ١","juz":29,"page":577},{"number":2,"text":"وَلَا أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ٢","juz":29,"page":577},{"number":3,"text":"أَيَحۡسِبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ٣","juz":29,"page":577},{"number":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥ ٤","juz":29,"page":577},{"number":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥","juz":29,"page":577},{"number":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ٦","juz":29,"page":577},{"number":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ ٧","juz":29,"page":577},{"number":8,"text":"وَخَسَفَ ٱلۡقَمَرُ ٨","juz":29,"page":577},{"number":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ٩","juz":29,"page":577},{"number":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ١٠","juz":29,"page":577},{"number":11,"text":"كَلَّا لَا وَزَرَ ١١","juz":29,"page":577},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ١٢","juz":29,"page":577},{"number":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ١٣","juz":29,"page":577},{"number":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤","juz":29,"page":577},{"number":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥","juz":29,"page":577},{"number":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦ إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرَانَهُۥ ١٦","juz":29,"page":577},{"number":17,"text":"فَإِذَا قَرَأۡنَٰهُۥ فَٱتَّبِعۡ قُرَانَهُۥ ١٧","juz":29,"page":577},{"number":18,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٨","juz":29,"page":577},{"number":19,"text":"كَلَّا بَلۡ يُحِبُّونَ ٱلۡعَاجِلَةَ ١٩","juz":29,"page":578},{"number":20,"text":"وَيَذَرُونَ ٱلۡأٓخِرَةَ ٢٠","juz":29,"page":578},{"number":21,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ ٢١","juz":29,"page":578},{"number":22,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ ٢٢","juz":29,"page":578},{"number":23,"text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ ٢٣","juz":29,"page":578},{"number":24,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ ٢٤","juz":29,"page":578},{"number":25,"text":"كَلَّا إِذَا بَلَغَتِ ٱلتَّرَاقِيَ ٢٥","juz":29,"page":578},{"number":26,"text":"وَقِيلَ مَن رَّاقٖ ٢٦","juz":29,"page":578},{"number":27,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ ٢٧","juz":29,"page":578},{"number":28,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ٢٨","juz":29,"page":578},{"number":29,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ ٢٩","juz":29,"page":578},{"number":30,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ ٣٠","juz":29,"page":578},{"number":31,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ٣١","juz":29,"page":578},{"number":32,"text":"ثُمَّ ذَهَبَ إِلَىٰ أَهۡلِهِۦ يَتَمَطَّىٰ ٣٢","juz":29,"page":578},{"number":33,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ٣٣","juz":29,"page":578},{"number":34,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ٣٤","juz":29,"page":578},{"number":35,"text":"أَيَحۡسِبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ٣٥","juz":29,"page":578},{"number":36,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ تُمۡنَىٰ ٣٦","juz":29,"page":578},{"number":37,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ ٣٧","juz":29,"page":578},{"number":38,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ ٣٨","juz":29,"page":578},{"number":39,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ ٣٩","juz":29,"page":578}]}