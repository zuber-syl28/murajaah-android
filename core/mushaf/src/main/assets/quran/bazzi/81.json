{"narration":"bazzi","surah":81,"ayahs":[{"number":1,"text":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ١","juz":30,"page":586},{"number":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ٢","juz":30,"page":586},{"number":3,"text":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ٣","juz":30,"page":586},{"number":4,"text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ٤","juz":30,"page":586},{"number":5,"text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ٥","juz":30,"page":586},{"number":6,"text":"وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ ٦","juz":30,"page":586},{"number":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ٧","juz":30,"page":586},{"number":8,"text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ٨","juz":30,"page":586},{"number":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ ٩","juz":30,"page":586},{"number":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ ١٠","juz":30,"page":586},{"number":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ١١","juz":30,"page":586},{"number":12,"text":"وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ ١٢","juz":30,"page":586},{"number":13,"text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ١٣","juz":30,"page":586},{"number":14,"text":"عَلِمَتۡ نَفۡسٞ مَّا أَحۡضَرَتۡ ١٤","juz":30,"page":586},{"number":15,"text":"فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ ١٥","juz":30,"page":586},{"number":16,"text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ ١٦","juz":30,"page":586},{"number":17,"text":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ ١٧","juz":30,"page":586},{"number":18,"text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ١٨","juz":30,"page":586},{"number":19,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ١٩","juz":30,"page":586},{"number":20,"text":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ٢٠","juz":30,"page":586},{"number":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖ ٢١","juz":30,"page":586},{"number":22,"text":"وَمَا صَاحِبُكُمُۥ بِمَجۡنُونٖ ٢٢","juz":30,"page":586},{"number":23,"text":"وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ ٢٣","juz":30,"page":586},{"number":24,"text":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينٖ ٢٤","juz":30,"page":586},{"number":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ٢٥","juz":30,"page":586},{"number":26,"text":"فَأَيۡنَ تَذۡهَبُونَ ٢٦","juz":30,"page":586},{"number":27,"text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧","juz":30,"page":586},{"number":28,"text":"لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ ٢٨","juz":30,"page":586},{"number":29,"text":"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩","juz":30,"page":586}]}