{"narration":"bazzi","surah":113,"ayahs":[{"number":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ ١","juz":30,"page":604},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ ٢","juz":30,"page":604},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ٣","juz":30,"page":604},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ ٤","juz":30,"page":604},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ٥","juz":30,"page":604}]}