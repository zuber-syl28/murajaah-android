{"narration":"bazzi","surah":97,"ayahs":[{"number":1,"text":"إِنَّا أَنزَلۡنَٰهُۥ فِي لَيۡلَةِ ٱلۡقَدۡرِ ١","juz":30,"page":598},{"number":2,"text":"وَمَا أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ ٢","juz":30,"page":598},{"number":3,"text":"لَيۡلَةُ ٱلۡقَدۡرِ ٣","juz":30,"page":598},{"number":4,"text":"خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ ٤","juz":30,"page":598},{"number":5,"text":"تَّنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِمُۥ مِن كُلِّ أَمۡرٖ ٥","juz":30,"page":598},{"number":6,"text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ ٦","juz":30,"page":598}]}