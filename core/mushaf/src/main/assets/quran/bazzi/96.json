{"narration":"bazzi","surah":96,"ayahs":[{"number":1,"text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ ١","juz":30,"page":597},{"number":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ ٢","juz":30,"page":597},{"number":3,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ ٣","juz":30,"page":597},{"number":4,"text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ ٤","juz":30,"page":597},{"number":5,"text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ٥","juz":30,"page":597},{"number":6,"text":"كَلَّا إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰ ٦","juz":30,"page":597},{"number":7,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰ ٧","juz":30,"page":597},{"number":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰ ٨","juz":30,"page":597},{"number":9,"text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ ٩","juz":30,"page":597},{"number":10,"text":"عَبۡدًا إِذَا صَلَّىٰ ١٠","juz":30,"page":597},{"number":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰ ١١","juz":30,"page":597},{"number":12,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰ ١٢","juz":30,"page":597},{"number":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰ ١٣","juz":30,"page":598},{"number":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ ١٤","juz":30,"page":598},{"number":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ ١٥","juz":30,"page":598},{"number":16,"text":"لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ ١٦","juz":30,"page":598},{"number":17,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ١٧","juz":30,"page":598},{"number":18,"text":"فَلۡيَدۡعُ نَادِيَهُۥ ١٨","juz":30,"page":598},{"number":19,"text":"سَنَدۡعُ ٱلزَّبَانِيَةَ ١٩","juz":30,"page":598},{"number":20,"text":"كَلَّا لَا تُطِعۡهُۥ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩ ٢٠","juz":30,"page":598}]}