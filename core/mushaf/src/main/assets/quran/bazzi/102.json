{"narration":"bazzi","surah":102,"ayahs":[{"number":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ ١","juz":30,"page":600},{"number":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ ٢","juz":30,"page":600},{"number":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ ٣","juz":30,"page":600},{"number":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ ٤","juz":30,"page":600},{"number":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ ٥","juz":30,"page":600},{"number":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ ٦","juz":30,"page":600},{"number":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ ٧","juz":30,"page":600},{"number":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ ٨","juz":30,"page":600}]}