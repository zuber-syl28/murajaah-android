{"narration":"bazzi","surah":95,"ayahs":[{"number":1,"text":"وَٱلتِّينِ وَٱلزَّيۡتُونِ ١","juz":30,"page":597},{"number":2,"text":"وَطُورِ سِينِينَ ٢","juz":30,"page":597},{"number":3,"text":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ٣","juz":30,"page":597},{"number":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي أَحۡسَنِ تَقۡوِيمٖ ٤","juz":30,"page":597},{"number":5,"text":"ثُمَّ رَدَدۡنَٰهُۥ أَسۡفَلَ سَٰفِلِينَ ٥","juz":30,"page":597},{"number":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمُۥ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ٦","juz":30,"page":597},{"number":7,"text":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ٧","juz":30,"page":597},{"number":8,"text":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ ٨","juz":30,"page":597}]}