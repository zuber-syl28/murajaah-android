{"narration":"bazzi","surah":78,"ayahs":[{"number":1,"text":"عَمَّ يَتَسَآءَلُونَ ١","juz":30,"page":582},{"number":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ٢","juz":30,"page":582},{"number":3,"text":"ٱلَّذِي هُمُۥ فِيهِۦ مُخۡتَلِفُونَ ٣","juz":30,"page":582},{"number":4,"text":"كَلَّا سَيَعۡلَمُونَ ٤","juz":30,"page":582},{"number":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ ٥","juz":30,"page":582},{"number":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ٦","juz":30,"page":582},{"number":7,"text":"وَٱلۡجِبَالَ أَوۡتَادٗا ٧","juz":30,"page":582},{"number":8,"text":"وَخَلَقۡنَٰكُمُۥ أَزۡوَٰجٗا ٨","juz":30,"page":582},{"number":9,"text":"وَجَعَلۡنَا نَوۡمَكُمُۥ سُبَاتٗا ٩","juz":30,"page":582},{"number":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ١٠","juz":30,"page":582},{"number":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ١١","juz":30,"page":582},{"number":12,"text":"وَبَنَيۡنَا فَوۡقَكُمُۥ سَبۡعٗا شِدَادٗا ١٢","juz":30,"page":582},{"number":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ١٣","juz":30,"page":582},{"number":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ١٤","juz":30,"page":582},{"number":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ١٥","juz":30,"page":582},{"number":16,"text":"وَجَنَّٰتٍ أَلۡفَافًا ١٦","juz":30,"page":582},{"number":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ١٧","juz":30,"page":582},{"number":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ١٨","juz":30,"page":582},{"number":19,"text":"وَفُتِّحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ١٩","juz":30,"page":582},{"number":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ٢٠","juz":30,"page":582},{"number":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ٢١","juz":30,"page":582},{"number":22,"text":"لِّلطَّٰغِينَ مَـَٔابٗا ٢٢","juz":30,"page":582},{"number":23,"text":"لَّٰبِثِينَ فِيهَا أَحۡقَابٗا ٢٣","juz":30,"page":582},{"number":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ٢٤","juz":30,"page":582},{"number":25,"text":"إِلَّا حَمِيمٗا وَغَسَاقٗا ٢٥","juz":30,"page":582},{"number":26,"text":"جَزَآءٗ وِفَاقًا ٢٦","juz":30,"page":582},{"number":27,"text":"إِنَّهُمُۥ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ٢٧","juz":30,"page":582},{"number":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ٢٨","juz":30,"page":582},{"number":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُۥ كِتَٰبٗا ٢٩","juz":30,"page":582},{"number":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥ إِلَّا عَذَابًا ٣٠","juz":30,"page":582},{"number":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا ٣١","juz":30,"page":583},{"number":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا ٣٢","juz":30,"page":583},{"number":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا ٣٣","juz":30,"page":583},{"number":34,"text":"وَكَأۡسٗا دِهَاقٗا ٣٤","juz":30,"page":583},{"number":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ٣٥","juz":30,"page":583},{"number":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ٣٦","juz":30,"page":583},{"number":37,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنُۖ لَا يَمۡلِكُونَ مِنۡهُۥ خِطَابٗا ٣٧","juz":30,"page":583},{"number":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا ٣٨","juz":30,"page":583},{"number":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ٣٩","juz":30,"page":583},{"number":40,"text":"إِنَّا أَنذَرۡنَٰكُمُۥ عَذَابٗا قَرِيبٗا ٤٠","juz":30,"page":583},{"number":41,"text":"يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُۥ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ٤١","juz":30,"page":583}]}