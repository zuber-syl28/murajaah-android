{"narration":"bazzi","surah":69,"ayahs":[{"number":1,"text":"ٱلۡحَآقَّةُ مَا ٱلۡحَآقَّةُ ١","juz":29,"page":566},{"number":2,"text":"وَمَا أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ ٢","juz":29,"page":566},{"number":3,"text":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ ٣","juz":29,"page":566},{"number":4,"text":"فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ ٤","juz":29,"page":566},{"number":5,"text":"وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ ٥","juz":29,"page":566},{"number":6,"text":"سَخَّرَهَا عَلَيۡهِمُۥ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمُۥ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ ٦","juz":29,"page":566},{"number":7,"text":"فَهَلۡ تَرَىٰ لَهُمُۥ مِنۢ بَاقِيَةٖ ٧","juz":29,"page":566},{"number":8,"text":"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ ٨","juz":29,"page":567},{"number":9,"text":"فَعَصَوۡاْ رَسُولَ رَبِّهِمُۥ فَأَخَذَهُمُۥ أَخۡذَةٗ رَّابِيَةً ٩","juz":29,"page":567},{"number":10,"text":"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمُۥ فِي ٱلۡجَارِيَةِ ١٠","juz":29,"page":567},{"number":11,"text":"لِنَجۡعَلَهَا لَكُمُۥ تَذۡكِرَةٗ وَتَعِيَهَا أُذُنٞ وَٰعِيَةٞ ١١","juz":29,"page":567},{"number":12,"text":"فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ ١٢","juz":29,"page":567},{"number":13,"text":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ ١٣","juz":29,"page":567},{"number":14,"text":"فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ ١٤","juz":29,"page":567},{"number":15,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ ١٥","juz":29,"page":567},{"number":16,"text":"وَٱلۡمَلَكُ عَلَىٰ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمُۥ يَوۡمَئِذٖ ثَمَٰنِيَةٞ ١٦","juz":29,"page":567},{"number":17,"text":"يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمُۥ خَافِيَةٞ ١٧","juz":29,"page":567},{"number":18,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ ١٨","juz":29,"page":567},{"number":19,"text":"إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ ١٩","juz":29,"page":567},{"number":20,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ٢٠","juz":29,"page":567},{"number":21,"text":"فِي جَنَّةٍ عَالِيَةٖ ٢١","juz":29,"page":567},{"number":22,"text":"قُطُوفُهَا دَانِيَةٞ ٢٢","juz":29,"page":567},{"number":23,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا أَسۡلَفۡتُمُۥ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ ٢٣","juz":29,"page":567},{"number":24,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ ٢٤","juz":29,"page":567},{"number":25,"text":"فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ ٢٥","juz":29,"page":567},{"number":26,"text":"وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ ٢٦","juz":29,"page":567},{"number":27,"text":"يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ ٢٧","juz":29,"page":567},{"number":28,"text":"مَا أَغۡنَىٰ عَنِّي مَالِيَهۡۜ ٢٨","juz":29,"page":567},{"number":29,"text":"هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ ٢٩","juz":29,"page":567},{"number":30,"text":"خُذُوهُۥ فَغُلُّوهُۥ ٣٠","juz":29,"page":567},{"number":31,"text":"ثُمَّ ٱلۡجَحِيمَ صَلُّوهُۥ ٣١","juz":29,"page":567},{"number":32,"text":"ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُۥ ٣٢","juz":29,"page":567},{"number":33,"text":"إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ ٣٣","juz":29,"page":567},{"number":34,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣٤","juz":29,"page":567},{"number":35,"text":"فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ ٣٥","juz":29,"page":567},{"number":36,"text":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ ٣٦","juz":29,"page":568},{"number":37,"text":"لَّا يَأۡكُلُهُۥ إِلَّا ٱلۡخَٰطِـُٔونَ ٣٧","juz":29,"page":568},{"number":38,"text":"فَلَا أُقۡسِمُ بِمَا تُبۡصِرُونَ ٣٨","juz":29,"page":568},{"number":39,"text":"وَمَا لَا تُبۡصِرُونَ ٣٩","juz":29,"page":568},{"number":40,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ٤٠","juz":29,"page":568},{"number":41,"text":"وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا يُؤۡمِنُونَ ٤١","juz":29,"page":568},{"number":42,"text":"وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا يَذَّكَّرُونَ ٤٢","juz":29,"page":568},{"number":43,"text":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٤٣","juz":29,"page":568},{"number":44,"text":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ ٤٤","juz":29,"page":568},{"number":45,"text":"لَأَخَذۡنَا مِنۡهُۥ بِٱلۡيَمِينِ ٤٥","juz":29,"page":568},{"number":46,"text":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ ٤٦","juz":29,"page":568},{"number":47,"text":"فَمَا مِنكُمُۥ مِنۡ أَحَدٍ عَنۡهُۥ حَٰجِزِينَ ٤٧","juz":29,"page":568},{"number":48,"text":"وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ ٤٨","juz":29,"page":568},{"number":49,"text":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُمُۥ مُكَذِّبِينَ ٤٩","juz":29,"page":568},{"number":50,"text":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ ٥٠","juz":29,"page":568},{"number":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ ٥١","juz":29,"page":568},{"number":52,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٥٢","juz":29,"page":568}]}