{"narration":"bazzi","surah":109,"ayahs":[{"number":1,"text":"قُلۡ يَٰأَيُّهَا ٱلۡكَٰفِرُونَ ١","juz":30,"page":603},{"number":2,"text":"لَا أَعۡبُدُ مَا تَعۡبُدُونَ ٢","juz":30,"page":603},{"number":3,"text":"وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ ٣","juz":30,"page":603},{"number":4,"text":"وَلَا أَنَا۠ عَابِدٞ مَّا عَبَدتُّمُۥ ٤","juz":30,"page":603},{"number":5,"text":"وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ ٥","juz":30,"page":603},{"number":6,"text":"لَكُمُۥ دِينُكُمُۥ وَلِي دِينِ ٦","juz":30,"page":603}]}