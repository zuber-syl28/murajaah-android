{"narration":"shouba","surah":75,"ayahs":[{"number":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ١","juz":29,"page":577},{"number":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ٢","juz":29,"page":577},{"number":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ٣","juz":29,"page":577},{"number":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ ٤","juz":29,"page":577},{"number":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥","juz":29,"page":577},{"number":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ٦","juz":29,"page":577},{"number":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ ٧","juz":29,"page":577},{"number":8,"text":"وَخَسَفَ ٱلۡقَمَرُ ٨","juz":29,"page":577},{"number":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ٩","juz":29,"page":577},{"number":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ١٠","juz":29,"page":577},{"number":11,"text":"كَلَّا لَا وَزَرَ ١١","juz":29,"page":577},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ١٢","juz":29,"page":577},{"number":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ١٣","juz":29,"page":577},{"number":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤","juz":29,"page":577},{"number":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥","juz":29,"page":577},{"number":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ ١٦","juz":29,"page":577},{"number":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ ١٧","juz":29,"page":577},{"number":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ ١٨","juz":29,"page":577},{"number":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٩","juz":29,"page":577},{"number":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ ٢٠","juz":29,"page":578},{"number":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ ٢١","juz":29,"page":578},{"number":22,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ ٢٢","juz":29,"page":578},{"number":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ ٢٣","juz":29,"page":578},{"number":24,"text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ ٢٤","juz":29,"page":578},{"number":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ ٢٥","juz":29,"page":578},{"number":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ ٢٦","juz":29,"page":578},{"number":27,"text":"وَقِيلَ مَن رَّاقٖ ٢٧","juz":29,"page":578},{"number":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ ٢٨","juz":29,"page":578},{"number":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ٢٩","juz":29,"page":578},{"number":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ ٣٠","juz":29,"page":578},{"number":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ ٣١","juz":29,"page":578},{"number":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ٣٢","juz":29,"page":578},{"number":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ ٣٣","juz":29,"page":578},{"number":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ٣٤","juz":29,"page":578},{"number":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ ٣٥","juz":29,"page":578},{"number":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ٣٦","juz":29,"page":578},{"number":37,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ تُمۡنَىٰ ٣٧","juz":29,"page":578},{"number":38,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ ٣٨","juz":29,"page":578},{"number":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣٩","juz":29,"page":578},{"number":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ ٤٠","juz":29,"page":578}]}