{"narration":"shouba","surah":93,"ayahs":[{"number":1,"text":"وَٱلضُّحَىٰ ١","juz":30,"page":596},{"number":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ ٢","juz":30,"page":596},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣","juz":30,"page":596},{"number":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤","juz":30,"page":596},{"number":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥","juz":30,"page":596},{"number":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦","juz":30,"page":596},{"number":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧","juz":30,"page":596},{"number":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨","juz":30,"page":596},{"number":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩","juz":30,"page":596},{"number":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠","juz":30,"page":596},{"number":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١","juz":30,"page":596}]}