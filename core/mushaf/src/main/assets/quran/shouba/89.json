{"narration":"shouba","surah":89,"ayahs":[{"number":1,"text":"وَٱلۡفَجۡرِ ١","juz":30,"page":593},{"number":2,"text":"وَلَيَالٍ عَشۡرٖ ٢","juz":30,"page":593},{"number":3,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ٣","juz":30,"page":593},{"number":4,"text":"وَٱلَّيۡلِ إِذَا يَسۡرِ ٤","juz":30,"page":593},{"number":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ٥","juz":30,"page":593},{"number":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ٦","juz":30,"page":593},{"number":7,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ ٧","juz":30,"page":593},{"number":8,"text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ٨","juz":30,"page":593},{"number":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ٩","juz":30,"page":593},{"number":10,"text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ١٠","juz":30,"page":593},{"number":11,"text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ١١","juz":30,"page":593},{"number":12,"text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ١٢","juz":30,"page":593},{"number":13,"text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ١٣","juz":30,"page":593},{"number":14,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ١٤","juz":30,"page":593},{"number":15,"text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ١٥","juz":30,"page":593},{"number":16,"text":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ١٦","juz":30,"page":593},{"number":17,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ١٧","juz":30,"page":593},{"number":18,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ١٨","juz":30,"page":593},{"number":19,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ١٩","juz":30,"page":593},{"number":20,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ٢٠","juz":30,"page":593},{"number":21,"text":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ٢١","juz":30,"page":593},{"number":22,"text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ٢٢","juz":30,"page":593},{"number":23,"text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ٢٣","juz":30,"page":594},{"number":24,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ٢٤","juz":30,"page":594},{"number":25,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٥","juz":30,"page":594},{"number":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ٢٦","juz":30,"page":594},{"number":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ٢٧","juz":30,"page":594},{"number":28,"text":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ٢٨","juz":30,"page":594},{"number":29,"text":"فَٱدۡخُلِي فِي عِبَٰدِي ٢٩","juz":30,"page":594},{"number":30,"text":"وَٱدۡخُلِي جَنَّتِي ٣٠","juz":30,"page":594}]}