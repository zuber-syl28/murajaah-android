{"narration":"shouba","surah":79,"ayahs":[{"number":1,"text":"وَٱلنَّٰزِعَٰتِ غَرۡقٗا ١","juz":30,"page":583},{"number":2,"text":"وَٱلنَّٰشِطَٰتِ نَشۡطٗا ٢","juz":30,"page":583},{"number":3,"text":"وَٱلسَّٰبِحَٰتِ سَبۡحٗا ٣","juz":30,"page":583},{"number":4,"text":"فَٱلسَّٰبِقَٰتِ سَبۡقٗا ٤","juz":30,"page":583},{"number":5,"text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا ٥","juz":30,"page":583},{"number":6,"text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ ٦","juz":30,"page":583},{"number":7,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ ٧","juz":30,"page":583},{"number":8,"text":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ ٨","juz":30,"page":583},{"number":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةٞ ٩","juz":30,"page":583},{"number":10,"text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ ١٠","juz":30,"page":583},{"number":11,"text":"أَءِذَا كُنَّا عِظَٰمٗا نَّٰخِرَةٗ ١١","juz":30,"page":583},{"number":12,"text":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ ١٢","juz":30,"page":583},{"number":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ ١٣","juz":30,"page":583},{"number":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ ١٤","juz":30,"page":583},{"number":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ١٥","juz":30,"page":583},{"number":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى ١٦","juz":30,"page":583},{"number":17,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ١٧","juz":30,"page":584},{"number":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ١٨","juz":30,"page":584},{"number":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ ١٩","juz":30,"page":584},{"number":20,"text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ ٢٠","juz":30,"page":584},{"number":21,"text":"فَكَذَّبَ وَعَصَىٰ ٢١","juz":30,"page":584},{"number":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ ٢٢","juz":30,"page":584},{"number":23,"text":"فَحَشَرَ فَنَادَىٰ ٢٣","juz":30,"page":584},{"number":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ ٢٤","juz":30,"page":584},{"number":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ ٢٥","juz":30,"page":584},{"number":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ ٢٦","juz":30,"page":584},{"number":27,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ٢٧","juz":30,"page":584},{"number":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا ٢٨","juz":30,"page":584},{"number":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا ٢٩","juz":30,"page":584},{"number":30,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ ٣٠","juz":30,"page":584},{"number":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا ٣١","juz":30,"page":584},{"number":32,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا ٣٢","juz":30,"page":584},{"number":33,"text":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٣","juz":30,"page":584},{"number":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ ٣٤","juz":30,"page":584},{"number":35,"text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ ٣٥","juz":30,"page":584},{"number":36,"text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ ٣٦","juz":30,"page":584},{"number":37,"text":"فَأَمَّا مَن طَغَىٰ ٣٧","juz":30,"page":584},{"number":38,"text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ٣٨","juz":30,"page":584},{"number":39,"text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ ٣٩","juz":30,"page":584},{"number":40,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ ٤٠","juz":30,"page":584},{"number":41,"text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ ٤١","juz":30,"page":584},{"number":42,"text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا ٤٢","juz":30,"page":584},{"number":43,"text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ ٤٣","juz":30,"page":584},{"number":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ٤٤","juz":30,"page":584},{"number":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا ٤٥","juz":30,"page":584},{"number":46,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا ٤٦","juz":30,"page":584}]}