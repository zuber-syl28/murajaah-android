{"narration":"shouba","surah":92,"ayahs":[{"number":1,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ١","juz":30,"page":595},{"number":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ٢","juz":30,"page":595},{"number":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ٣","juz":30,"page":595},{"number":4,"text":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ٤","juz":30,"page":595},{"number":5,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ٥","juz":30,"page":595},{"number":6,"text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ ٦","juz":30,"page":595},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ٧","juz":30,"page":595},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ٨","juz":30,"page":595},{"number":9,"text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ ٩","juz":30,"page":595},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ١٠","juz":30,"page":596},{"number":11,"text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ١١","juz":30,"page":596},{"number":12,"text":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ١٢","juz":30,"page":596},{"number":13,"text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ١٣","juz":30,"page":596},{"number":14,"text":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ١٤","juz":30,"page":596},{"number":15,"text":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ١٥","juz":30,"page":596},{"number":16,"text":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ١٦","juz":30,"page":596},{"number":17,"text":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ١٧","juz":30,"page":596},{"number":18,"text":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ١٨","juz":30,"page":596},{"number":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ١٩","juz":30,"page":596},{"number":20,"text":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ٢٠","juz":30,"page":596},{"number":21,"text":"وَلَسَوۡفَ يَرۡضَىٰ ٢١","juz":30,"page":596}]}