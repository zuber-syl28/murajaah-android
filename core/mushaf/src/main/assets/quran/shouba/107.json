{"narration":"shouba","surah":107,"ayahs":[{"number":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ١","juz":30,"page":602},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ٢","juz":30,"page":602},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ٣","juz":30,"page":602},{"number":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ ٤","juz":30,"page":602},{"number":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ٥","juz":30,"page":602},{"number":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ ٦","juz":30,"page":602},{"number":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ ٧","juz":30,"page":602}]}