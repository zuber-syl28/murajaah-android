{"narration":"shouba","surah":55,"ayahs":[{"number":1,"text":"ٱلرَّحۡمَٰنُ ١","juz":27,"page":531},{"number":2,"text":"عَلَّمَ ٱلۡقُرۡءَانَ ٢","juz":27,"page":531},{"number":3,"text":"خَلَقَ ٱلۡإِنسَٰنَ ٣","juz":27,"page":531},{"number":4,"text":"عَلَّمَهُ ٱلۡبَيَانَ ٤","juz":27,"page":531},{"number":5,"text":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ٥","juz":27,"page":531},{"number":6,"text":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ٦","juz":27,"page":531},{"number":7,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ٧","juz":27,"page":531},{"number":8,"text":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ٨","juz":27,"page":531},{"number":9,"text":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ٩","juz":27,"page":531},{"number":10,"text":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ١٠","juz":27,"page":531},{"number":11,"text":"فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ١١","juz":27,"page":531},{"number":12,"text":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ١٢","juz":27,"page":531},{"number":13,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٣","juz":27,"page":531},{"number":14,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ١٤","juz":27,"page":531},{"number":15,"text":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ١٥","juz":27,"page":531},{"number":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٦","juz":27,"page":531},{"number":17,"text":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ١٧","juz":27,"page":531},{"number":18,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ١٨","juz":27,"page":531},{"number":19,"text":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ١٩","juz":27,"page":532},{"number":20,"text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ٢٠","juz":27,"page":532},{"number":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢١","juz":27,"page":532},{"number":22,"text":"يَخۡرُجُ مِنۡهُمَا ٱللُّولُؤُ وَٱلۡمَرۡجَانُ ٢٢","juz":27,"page":532},{"number":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٢٣","juz":27,"page":532},{"number":24,"text":"وَلَهُ ٱلۡج