533},{"number":66,"text":"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ ٦٦","juz":27,"page":533},{"number":67,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٧","juz":27,"page":533},{"number":68,"text":"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ ٦٨","juz":27,"page":533},{"number":69,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٦٩","juz":27,"page":533},{"number":70,"text":"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ ٧٠","juz":27,"page":534},{"number":71,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧١","juz":27,"page":534},{"number":72,"text":"حُورٞ مَّقۡصُورَٰتٞ فِي ٱلۡخِيَامِ ٧٢","juz":27,"page":534},{"number":73,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٣","juz":27,"page":534},{"number":74,"text":"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ٧٤","juz":27,"page":534},{"number":75,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٥","juz":27,"page":534},{"number":76,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ ٧٦","juz":27,"page":534},{"number":77,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ٧٧","juz":27,"page":534},{"number":78,"text":"تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ٧٨","juz":27,"page":534}]}