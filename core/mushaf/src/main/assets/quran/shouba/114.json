{"narration":"shouba","surah":114,"ayahs":[{"number":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ١","juz":30,"page":604},{"number":2,"text":"مَلِكِ ٱلنَّاسِ ٢","juz":30,"page":604},{"number":3,"text":"إِلَٰهِ ٱلنَّاسِ ٣","juz":30,"page":604},{"number":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ٤","juz":30,"page":604},{"number":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ٥","juz":30,"page":604},{"number":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ٦","juz":30,"page":604}]}