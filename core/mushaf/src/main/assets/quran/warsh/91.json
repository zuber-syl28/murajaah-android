{"narration":"warsh","surah":91,"ayahs":[{"number":1,"text":"وَالشَّمْسِ وَضُحَيٰهَا ١","juz":30,"page":595},{"number":2,"text":"وَالْقَمَرِ إِذَا تَلَيٰهَا ٢","juz":30,"page":595},{"number":3,"text":"وَالنَّه۪ارِ إِذَا جَلَّيٰهَا ٣","juz":30,"page":595},{"number":4,"text":" وَاليْلِ إِذَا يَغْشَيٰهَا ٤","juz":30,"page":595},{"number":5,"text":"وَالسَّمَآءِ وَمَا بَنَيٰهَا ٥","juz":30,"page":595},{"number":6,"text":"وَالَارْضِ وَمَا طَحَيٰهَا ٦","juz":30,"page":595},{"number":7,"text":"وَنَفْسٖ وَمَا سَوَّيٰهَا ٧","juz":30,"page":595},{"number":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا ٨","juz":30,"page":595},{"number":9,"text":"قَدَ اَفْلَحَ مَن زَكَّيٰهَا ٩","juz":30,"page":595},{"number":10,"text":"وَقَدْ خَابَ مَن دَسَّيٰهَاۖ ١٠","juz":30,"page":595},{"number":11,"text":" كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ ١١","juz":30,"page":595},{"number":12,"text":"إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا ١٢","juz":30,"page":595},{"number":13,"text":"فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا ١٣","juz":30,"page":595},{"number":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ ١٤","juz":30,"page":595},{"number":15,"text":"فَلَا يَخَافُ عُقْبَٰهَاۖ ١٥","juz":30,"page":595}]}