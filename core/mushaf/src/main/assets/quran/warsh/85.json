{"narration":"warsh","surah":85,"ayahs":[{"number":1,"text":"وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ ١","juz":30,"page":590},{"number":2,"text":"وَالْيَوْمِ اِ۬لْمَوْعُودِ ٢","juz":30,"page":590},{"number":3,"text":"وَشَاهِدٖ وَمَشْهُودٖ ٣","juz":30,"page":590},{"number":4,"text":" قُتِلَ أَصْحَٰبُ اُ۬لُاخْدُودِ ٤","juz":30,"page":590},{"number":5,"text":"اِ۬لنّ۪ارِ ذَاتِ اِ۬لْوَقُودِ ٥","juz":30,"page":590},{"number":6,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٞ ٦","juz":30,"page":590},{"number":7,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُومِنِينَ شُهُودٞۖ ٧","juz":30,"page":590},{"number":8,"text":"وَمَا نَقَمُواْ مِنْهُمُۥٓ إِلَّآ أَنْ يُّومِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ ٨","juz":30,"page":590},{"number":9,"text":"اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ ٩","juz":30,"page":590},{"number":10,"text":"اِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُومِنِينَ وَالْمُومِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ ١٠","juz":30,"page":590},{"number":11,"text":"إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ ١١","juz":30,"page":590},{"number":12,"text":"۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ ١٢","juz":30,"page":590},{"number":13,"text":"اِنَّهُۥ هُوَ يُبْدِۓُ وَيُعِيدُۖ ١٣","juz":30,"page":590},{"number":14,"text":"وَهُوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ ١٤","juz":30,"page":590},{"number":15,"text":" ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ ١٥","juz":30,"page":590},{"number":16,"text":"فَعَّالٞ لِّمَا يُرِيدُۖ ١٦","juz":30,"page":590},{"number":17,"text":"هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْجُنُودِ ١٧","juz":30,"page":590},{"number":18,"text":"فِرْعَوْنَ وَثَمُودَۖ ١٨","juz":30,"page":590},{"number":19,"text":"بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ ١٩","juz":30,"page":590},{"number":20,"text":"وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ ٢٠","juz":30,"page":590},{"number":21,"text":"بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ ٢١","juz":30,"page":590},{"number":22,"text":"فِے لَوْحٖ مَّحْفُوظٞۖ ٢٢","juz":30,"page":590}]}