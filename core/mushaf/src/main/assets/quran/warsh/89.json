{"narration":"warsh","surah":89,"ayahs":[{"number":1,"text":"وَالْفَجْرِ ١","juz":30,"page":593},{"number":2,"text":"وَلَيَالٍ عَشْرٖ ٢","juz":30,"page":593},{"number":3,"text":"وَالشَّفْعِ وَالْوَتْرِ ٣","juz":30,"page":593},{"number":4,"text":"وَاليْلِ إِذَا يَسْرِۦ ٤","juz":30,"page":593},{"number":5,"text":"هَلْ فِے ذَٰلِكَ قَسَمٞ لِّذِے حِجْرٍۖ ٥","juz":30,"page":593},{"number":6,"text":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ٦","juz":30,"page":593},{"number":7,"text":" اِرَمَ ذَاتِ اِ۬لْعِمَادِ ٧","juz":30,"page":593},{"number":8,"text":"اِ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے اِ۬لْبِلَٰدِ ٨","juz":30,"page":593},{"number":9,"text":"وَثَمُودَ اَ۬لذِينَ جَابُواْ اُ۬لصَّخْرَ بِالْوَادِۦ ٩","juz":30,"page":593},{"number":10,"text":"وَفِرْعَوْنَ ذِے اِ۬لَاوْتَادِ ١٠","juz":30,"page":593},{"number":11,"text":"اِ۬لذِينَ طَغَوْاْ فِے اِ۬لْبِلَٰدِ ١١","juz":30,"page":593},{"number":12,"text":"فَأَكْثَرُواْ فِيهَا اَ۬لْفَسَادَ ١٢","juz":30,"page":593},{"number":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ ١٣","juz":30,"page":593},{"number":14,"text":"اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ ١٤","juz":30,"page":593},{"number":15,"text":"فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ ١٥","juz":30,"page":593},{"number":16,"text":"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ ١٦","juz":30,"page":593},{"number":17,"text":"وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ ١٧","juz":30,"page":593},{"number":18,"text":"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ ١٨","juz":30,"page":593},{"number":19,"text":"كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْيَتِيمَ ١٩","juz":30,"page":593},{"number":20,"text":"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِ ٢٠","juz":30,"page":593},{"number":21,"text":"وَتَاكُلُونَ اَ۬لتُّرَاثَ أَكْلاٗ لَّمّاٗ ٢١","juz":30,"page":593},{"number":22,"text":"وَتُحِبُّونَ اَ۬لْمَالَ حُبّاٗ جَمّاٗ ٢٢","juz":30,"page":593},{"number":23,"text":"كَلَّآۖ إِذَا دُكَّتِ اِ۬لَارْضُ دَكّاٗ دَكّاٗ ٢٣","juz":30,"page":593},{"number":24,"text":"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاٗ صَفّاٗ ٢٤","juz":30,"page":593},{"number":25,"text":" وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ ٢٥","juz":30,"page":594},{"number":26,"text":"يَوْمَئِذٖ يَتَذَكَّرُ اُ۬لِانسَٰنُ وَأَنّ۪ىٰ لَهُ اُ۬لذِّكْر۪ىٰۖ ٢٦","juz":30,"page":594},{"number":27,"text":"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِےۖ ٢٧","juz":30,"page":594},{"number":28,"text":"فَيَوْمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ٢٨","juz":30,"page":594},{"number":29,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞۖ ٢٩","juz":30,"page":594},{"number":30,"text":"يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ ٣٠","juz":30,"page":594},{"number":31,"text":"اُ۪رْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرْضِيَّةٗ ٣١","juz":30,"page":594},{"number":32,"text":" فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِےۖ ٣٢","juz":30,"page":594}]}