{"narration":"warsh","surah":37,"ayahs":[{"number":1,"text":"وَالصَّٰٓفَّٰتِ صَفّاٗ ١","juz":23,"page":446},{"number":2,"text":"فَالزَّٰجِرَٰتِ زَجْراٗ ٢","juz":23,"page":446},{"number":3,"text":"فَالتَّٰلِيَٰتِ ذِكْراً ٣","juz":23,"page":446},{"number":4,"text":"اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ ٤","juz":23,"page":446},{"number":5,"text":"رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ ٥","juz":23,"page":446},{"number":6,"text":"إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ ٦","juz":23,"page":446},{"number":7,"text":"وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ ٧","juz":23,"page":446},{"number":8,"text":" لَّا يَسْمَعُونَ إِلَى اَ۬لْمَلَإِ اِ۬لَاعْل۪ىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ ٨","juz":23,"page":446},{"number":9,"text":"دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ ٩","juz":23,"page":446},{"number":10,"text":"اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ ١٠","juz":23,"page":446},{"number":11,"text":" فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ ١١","juz":23,"page":446},{"number":12,"text":"بَلْ عَجِبْتَ وَيَسْخَرُونَۖ ١٢","juz":23,"page":446},{"number":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ ١٣","juz":23,"page":446},{"number":14,"text":"وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ ١٤","juz":23,"page":446},{"number":15,"text":" وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ ١٥","juz":23,"page":446},{"number":16,"text":"اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ ١٦","juz":23,"page":446},{"number":17,"text":"أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ ١٧","juz":23,"page":446},{"number":18,"text":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ ١٨","juz":23,"page":446},{"number":19,"text":" فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ ١٩","juz":23,"page":446},{"number":20,"text":"وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ ٢٠","juz":23,"page":446},{"number":21,"text":"هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ ٢١","juz":23,"page":446},{"number":22,"text":" ۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ ٢٢","juz":23,"page":446},{"number":23,"text":"مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ ٢٣","juz":23,"page":446},{"number":24,"text":"وَقِفُوهُمُۥٓ إِنَّهُم مَّسْـُٔولُونَۖ ٢٤","juz":23,"page":446},{"number":25,"text":" مَا لَكُمْ لَا تَنَاصَرُونَۖ ٢٥","juz":23,"page":447},{"number":26,"text":"بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ ٢٦","juz":23,"page":447},{"number":27,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ ٢٧","juz":23,"page":447},{"number":28,"text":"قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ ٢٨","juz":23,"page":447},{"number":29,"text":"قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ ٢٩","juz":23,"page":447},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ ٣٠","juz":23,"page":447},{"number":31,"text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ ٣١","juz":23,"page":447},{"number":32,"text":"فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ ٣٢","juz":23,"page":447},{"number":33,"text":"فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ ٣٣","juz":23,"page":447},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ ٣٤","juz":23,"page":447},{"number":35,"text":"إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ ٣٥","juz":23,"page":447},{"number":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ ٣٦","juz":23,"page":447},{"number":37,"text":"بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ ٣٧","juz":23,"page":447},{"number":38,"text":"إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ ٣٨","juz":23,"page":447},{"number":39,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ٣٩","juz":23,"page":447},{"number":40,"text":" إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ ٤٠","juz":23,"page":447},{"number":41,"text":"أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ ٤١","juz":23,"page":447},{"number":42,"text":"فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ ٤٢","juz":23,"page":447},{"number":43,"text":"فِے جَنَّٰتِ اِ۬لنَّعِيمِ ٤٣","juz":23,"page":447},{"number":44,"text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ ٤٤","juz":23,"page":447},{"number":45,"text":" يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ ٤٥","juz":23,"page":447},{"number":46,"text":"بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦","juz":23,"page":447},{"number":47,"text":" لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ ٤٧","juz":23,"page":447},{"number":48,"text":"وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ ٤٨","juz":23,"page":447},{"number":49,"text":"كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ ٤٩","juz":23,"page":447},{"number":50,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ ٥٠","juz":23,"page":447},{"number":51,"text":"۞ قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ ٥١","juz":23,"page":447},{"number":52,"text":" يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ ٥٢","juz":23,"page":448},{"number":53,"text":"أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ ٥٣","juz":23,"page":448},{"number":54,"text":"قَالَ هَلَ اَنتُم مُّطَّلِعُونَ ٥٤","juz":23,"page":448},{"number":55,"text":"فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ ٥٥","juz":23,"page":448},{"number":56,"text":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ ٥٦","juz":23,"page":448},{"number":57,"text":"وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ ٥٧","juz":23,"page":448},{"number":58,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ ٥٨","juz":23,"page":448},{"number":59,"text":"إِلَّا مَوْتَتَنَا اَ۬لُاول۪ىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ ٥٩","juz":23,"page":448},{"number":60,"text":"إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ ٦٠","juz":23,"page":448},{"number":61,"text":" لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ ٦١","juz":23,"page":448},{"number":62,"text":"أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ ٦٢","juz":23,"page":448},{"number":63,"text":"إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ ٦٣","juz":23,"page":448},{"number":64,"text":"إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ ٦٤","juz":23,"page":448},{"number":65,"text":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ ٦٥","juz":23,"page":448},{"number":66,"text":" فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ ٦٦","juz":23,"page":448},{"number":67,"text":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ ٦٧","juz":23,"page":448},{"number":68,"text":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ ٦٨","juz":23,"page":448},{"number":69,"text":" إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ ٦٩","juz":23,"page":448},{"number":70,"text":"فَهُمْ عَلَىٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ ٧٠","juz":23,"page":448},{"number":71,"text":" وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ ٧١","juz":23,"page":448},{"number":72,"text":"وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ ٧٢","juz":23,"page":448},{"number":73,"text":"فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ ٧٣","juz":23,"page":448},{"number":74,"text":" إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ ٧٤","juz":23,"page":448},{"number":75,"text":"وَلَقَدْ نَاد۪يٰنَا نُوحٞ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ ٧٥","juz":23,"page":448},{"number":76,"text":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ ٧٦","juz":23,"page":448},{"number":77,"text":" وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ ٧٧","juz":23,"page":449},{"number":78,"text":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ ٧٨","juz":23,"page":449},{"number":79,"text":" سَلَٰمٌ عَلَىٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ ٧٩","juz":23,"page":449},{"number":80,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ٨٠","juz":23,"page":449},{"number":81,"text":" إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ ٨١","juz":23,"page":449},{"number":82,"text":"ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ ٨٢","juz":23,"page":449},{"number":83,"text":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ ٨٣","juz":23,"page":449},{"number":84,"text":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ ٨٤","juz":23,"page":449},{"number":85,"text":"اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ ٨٥","juz":23,"page":449},{"number":86,"text":"أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ ٨٦","juz":23,"page":449},{"number":87,"text":" فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ ٨٧","juz":23,"page":449},{"number":88,"text":"فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ ٨٨","juz":23,"page":449},{"number":89,"text":" فَقَالَ إِنِّے سَقِيمٞ ٨٩","juz":23,"page":449},{"number":90,"text":"فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ ٩٠","juz":23,"page":449},{"number":91,"text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ ٩١","juz":23,"page":449},{"number":92,"text":"مَا لَكُمْ لَا تَنطِقُونَۖ ٩٢","juz":23,"page":449},{"number":93,"text":"فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ ٩٣","juz":23,"page":449},{"number":94,"text":"فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ ٩٤","juz":23,"page":449},{"number":95,"text":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ ٩٥","juz":23,"page":449},{"number":96,"text":" وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ ٩٦","juz":23,"page":449},{"number":97,"text":"قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ ٩٧","juz":23,"page":449},{"number":98,"text":"فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ ٩٨","juz":23,"page":449},{"number":99,"text":"وَقَالَ إِنِّے ذَاهِبٌ اِلَىٰ رَبِّے سَيَهْدِينِۖ ٩٩","juz":23,"page":449},{"number":100,"text":"رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ ١٠٠","juz":23,"page":449},{"number":101,"text":" فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ ١٠١","juz":23,"page":449},{"number":102,"text":"فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪ىٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪ىٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ ١٠٢","juz":23,"page":449},{"number":103,"text":" فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ ١٠٣","juz":23,"page":450},{"number":104,"text":"وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ ١٠٤","juz":23,"page":450},{"number":105,"text":" قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ١٠٥","juz":23,"page":450},{"number":106,"text":"إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ ١٠٦","juz":23,"page":450},{"number":107,"text":"وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ ١٠٧","juz":23,"page":450},{"number":108,"text":"وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ ١٠٨","juz":23,"page":450},{"number":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَۖ ١٠٩","juz":23,"page":450},{"number":110,"text":"كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ١١٠","juz":23,"page":450},{"number":111,"text":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ ١١١","juz":23,"page":450},{"number":112,"text":"وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ ١١٢","juz":23,"page":450},{"number":113,"text":"وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ ١١٣","juz":23,"page":450},{"number":114,"text":"۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوس۪ىٰ وَهَٰرُونَ ١١٤","juz":23,"page":450},{"number":115,"text":"وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ ١١٥","juz":23,"page":450},{"number":116,"text":"وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ ١١٦","juz":23,"page":450},{"number":117,"text":"وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ ١١٧","juz":23,"page":450},{"number":118,"text":"وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ ١١٨","juz":23,"page":450},{"number":119,"text":" وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ ١١٩","juz":23,"page":450},{"number":120,"text":"سَلَٰمٌ عَلَىٰ مُوس۪ىٰ وَهَٰرُونَۖ ١٢٠","juz":23,"page":450},{"number":121,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ١٢١","juz":23,"page":450},{"number":122,"text":"إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ ١٢٢","juz":23,"page":450},{"number":123,"text":"وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ ١٢٣","juz":23,"page":450},{"number":124,"text":" إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ ١٢٤","juz":23,"page":450},{"number":125,"text":"أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ ١٢٥","juz":23,"page":450},{"number":126,"text":"اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ ١٢٦","juz":23,"page":450},{"number":127,"text":" فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ ١٢٧","juz":23,"page":451},{"number":128,"text":"إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ ١٢٨","juz":23,"page":451},{"number":129,"text":" وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ ١٢٩","juz":23,"page":451},{"number":130,"text":"سَلَٰمٌ عَلَىٰٓ ءَالِ يَاسِينَۖ ١٣٠","juz":23,"page":451},{"number":131,"text":"إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ ١٣١","juz":23,"page":451},{"number":132,"text":"إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ ١٣٢","juz":23,"page":451},{"number":133,"text":" وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ ١٣٣","juz":23,"page":451},{"number":134,"text":"إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ ١٣٤","juz":23,"page":451},{"number":135,"text":" إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ ١٣٥","juz":23,"page":451},{"number":136,"text":"ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ ١٣٦","juz":23,"page":451},{"number":137,"text":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ ١٣٧","juz":23,"page":451},{"number":138,"text":"وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ ١٣٨","juz":23,"page":451},{"number":139,"text":"وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ ١٣٩","juz":23,"page":451},{"number":140,"text":"إِذَ اَبَقَ إِلَى اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ ١٤٠","juz":23,"page":451},{"number":141,"text":" فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ ١٤١","juz":23,"page":451},{"number":142,"text":"فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ ١٤٢","juz":23,"page":451},{"number":143,"text":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ ١٤٣","juz":23,"page":451},{"number":144,"text":"لَلَبِثَ فِے بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَۖ ١٤٤","juz":23,"page":451},{"number":145,"text":"۞ فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهُوَ سَقِيمٞۖ ١٤٥","juz":23,"page":451},{"number":146,"text":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ ١٤٦","juz":23,"page":451},{"number":147,"text":"وَأَرْسَلْنَٰهُ إِلَىٰ مِاْئَةِ أَلْفٍ اَوْ يَزِيدُونَۖ ١٤٧","juz":23,"page":451},{"number":148,"text":"فَـَٔامَنُواْ فَمَتَّعْنَٰهُمُۥٓ إِلَىٰ 