{"narration":"warsh","surah":113,"ayahs":[{"number":1,"text":"قُلَ اَعُوذُ بِرَبِّ اِ۬لْفَلَقِ ١","juz":30,"page":604},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ ٢","juz":30,"page":604},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ اِذَا وَقَبَ ٣","juz":30,"page":604},{"number":4,"text":"وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ ٤","juz":30,"page":604},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ اِذَا حَسَدَۖ ٥","juz":30,"page":604}]}