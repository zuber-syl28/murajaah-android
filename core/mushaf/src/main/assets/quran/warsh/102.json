{"narration":"warsh","surah":102,"ayahs":[{"number":1,"text":"اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ ١","juz":30,"page":600},{"number":2,"text":"حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ ٢","juz":30,"page":600},{"number":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ ٣","juz":30,"page":600},{"number":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ ٤","juz":30,"page":600},{"number":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ ٥","juz":30,"page":600},{"number":6,"text":"لَتَرَوُنَّ اَ۬لْجَحِيمَ ٦","juz":30,"page":600},{"number":7,"text":" ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ ٧","juz":30,"page":600},{"number":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ ٨","juz":30,"page":600}]}