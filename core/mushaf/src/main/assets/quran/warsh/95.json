{"narration":"warsh","surah":95,"ayahs":[{"number":1,"text":"وَالتِّينِ وَالزَّيْتُونِ ١","juz":30,"page":597},{"number":2,"text":"وَطُورِ سِينِينَ ٢","juz":30,"page":597},{"number":3,"text":"وَهَٰذَا اَ۬لْبَلَدِ اِ۬لَامِينِ ٣","juz":30,"page":597},{"number":4,"text":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِےٓ أَحْسَنِ تَقْوِيمٖ ٤","juz":30,"page":597},{"number":5,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ ٥","juz":30,"page":597},{"number":6,"text":" إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ ٦","juz":30,"page":597},{"number":7,"text":" فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ ٧","juz":30,"page":597},{"number":8,"text":"أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ ٨","juz":30,"page":597}]}