{"narration":"warsh","surah":56,"ayahs":[{"number":1,"text":"إِذَا وَقَعَتِ اِ۬لْوَاقِعَةُ ١","juz":27,"page":534},{"number":2,"text":"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ ٢","juz":27,"page":534},{"number":3,"text":"خَافِضَةٞ رَّافِعَةٌ ٣","juz":27,"page":534},{"number":4,"text":" اِذَا رُجَّتِ اِ۬لَارْضُ رَجّاٗ ٤","juz":27,"page":534},{"number":5,"text":"وَبُسَّتِ اِ۬لْجِبَالُ بَسّاٗ ٥","juz":27,"page":534},{"number":6,"text":"فَكَانَتْ هَبَآءٗ مُّنۢبَثّاٗ ٦","juz":27,"page":534},{"number":7,"text":"وَكُنتُمُۥٓ أَزْوَٰجاٗ ثَلَٰثَةٗۖ ٧","juz":27,"page":534},{"number":8,"text":"فَأَصْحَٰبُ اُ۬لْمَيْمَنَةِ ٨","juz":27,"page":534},{"number":9,"text":" مَآ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ ٩","juz":27,"page":534},{"number":10,"text":"وَأَصْحَٰبُ اُ۬لْمَشْـَٔمَةِ ١٠","juz":27,"page":534},{"number":11,"text":"مَآ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١١","juz":27,"page":534},{"number":12,"text":"وَالسَّٰبِقُونَ اَ۬لسَّٰبِقُونَۖ ١٢","juz":27,"page":534},{"number":13,"text":"أُوْلَٰٓئِكَ اَ۬لْمُقَرَّبُونَ ١٣","juz":27,"page":534},{"number":14,"text":" فِے جَنَّٰتِ اِ۬لنَّعِيمِۖ ١٤","juz":27,"page":534},{"number":15,"text":"ثُلَّةٞ مِّنَ اَ۬لَاوَّلِينَ ١٥","juz":27,"page":534},{"number":16,"text":"وَقَلِيلٞ مِّنَ اَ۬لَاخِرِينَ ١٦","juz":27,"page":534},{"number":17,"text":" عَلَىٰ سُرُرٖ مَّوْضُونَةٖ ١٧","juz":27,"page":534},{"number":18,"text":"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ ١٨","juz":27,"page":534},{"number":19,"text":" يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ ١٩","juz":27,"page":535},{"number":20,"text":"بِأَكْوَابٖ وَأَبَارِيقَ ٢٠","juz":27,"page":535},{"number":21,"text":"وَكَأْسٖ مِّن مَّعِينٖ ٢١","juz":27,"page":535},{"number":22,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ٢٢","juz":27,"page":535},{"number":23,"text":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣","juz":27,"page":535},{"number":24,"text":"وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ ٢٤","juz":27,"page":535},{"number":25,"text":"وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ ٢٥","juz":27,"page":535},{"number":