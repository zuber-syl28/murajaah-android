اَ۬لَاوَّلُونَۖ ٥١","juz":27,"page":535},{"number":52,"text":"۞ قُلِ اِنَّ اَ۬لَاوَّلِينَ وَالَاخِرِينَ لَمَجْمُوعُونَ ٥٢","juz":27,"page":535},{"number":53,"text":"إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ ٥٣","juz":27,"page":535},{"number":54,"text":" ثُمَّ إِنَّكُمُۥٓ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لْمُكَذِّبُونَ ٥٤","juz":27,"page":536},{"number":55,"text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٥","juz":27,"page":536},{"number":56,"text":"فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ ٥٦","juz":27,"page":536},{"number":57,"text":"فَشَٰرِبُونَ عَلَيْهِ مِنَ اَ۬لْحَمِيمِ ٥٧","juz":27,"page":536},{"number":58,"text":" فَشَٰرِبُونَ شُرْبَ اَ۬لْهِيمِۖ ٥٨","juz":27,"page":536},{"number":59,"text":"هَٰذَا نُزُلُهُمْ يَوْمَ اَ۬لدِّينِۖ ٥٩","juz":27,"page":536},{"number":60,"text":"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ ٦٠","juz":27,"page":536},{"number":61,"text":"أَفَرَٰٓيْتُم مَّا تُمْنُونَ ٦١","juz":27,"page":536},{"number":62,"text":"ءَآنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ اُ۬لْخَٰلِقُونَۖ ٦٢","juz":27,"page":536},{"number":63,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ اُ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ ٦٣","juz":27,"page":536},{"number":64,"text":" عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ ٦٤","juz":27,"page":536},{"number":65,"text":"وَلَقَدْ عَلِمْتُمُ اُ۬لنَّشْأَةَ اَ۬لُاول۪ىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ ٦٥","juz":27,"page":536},{"number":66,"text":"أَفَرَٰٓيْتُم مَّا تَحْرُثُونَ ٦٦","juz":27,"page":536},{"number":67,"text":" ءَآنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ اُ۬لزَّٰرِعُونَۖ ٦٧","juz":27,"page":536},{"number":68,"text":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماٗ فَظَلْتُمْ تَفَكَّهُونَ ٦٨","juz":27,"page":536},{"number":69,"text":"إِنَّا لَمُغْرَمُونَ ٦٩","juz":27,"page":536},{"number":70,"text":"بَلْ نَحْنُ مَحْرُومُونَۖ ٧٠","juz":27,"page":536},{"number":71,"text":"أَفَرَٰٓيْتُمُ اُ۬لْمَآءَ اَ۬لذِے تَشْرَبُونَ ٧١","juz":27,"page":536},{"number":72,"text":"ءَآنتُمُۥٓ أَنزَلْتُمُوهُ مِنَ اَ۬لْمُزْنِ أَمْ نَحْنُ اُ۬لْمُنزِلُونَۖ ٧٢","juz":27,"page