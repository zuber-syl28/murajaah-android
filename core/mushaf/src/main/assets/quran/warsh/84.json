{"narration":"warsh","surah":84,"ayahs":[{"number":1,"text":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ ١","juz":30,"page":589},{"number":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ٢","juz":30,"page":589},{"number":3,"text":"وَإِذَا اَ۬لَارْضُ مُدَّتْ ٣","juz":30,"page":589},{"number":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ ٤","juz":30,"page":589},{"number":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ ٥","juz":30,"page":589},{"number":6,"text":" يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ ٦","juz":30,"page":589},{"number":7,"text":"فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ٧","juz":30,"page":589},{"number":8,"text":"فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ ٨","juz":30,"page":589},{"number":9,"text":" وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُوراٗۖ ٩","juz":30,"page":589},{"number":10,"text":"وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ ١٠","juz":30,"page":589},{"number":11,"text":" فَسَوْفَ يَدْعُواْ ثُبُوراٗ ١١","juz":30,"page":589},{"number":12,"text":"وَيُصَلَّىٰ سَعِيراًۖ ١٢","juz":30,"page":589},{"number":13,"text":"اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ ١٣","juz":30,"page":589},{"number":14,"text":"اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ ١٤","juz":30,"page":589},{"number":15,"text":"بَل۪ىٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ ١٥","juz":30,"page":589},{"number":16,"text":" ۞ فَلَآ أُقْسِمُ بِالشَّفَقِ ١٦","juz":30,"page":589},{"number":17,"text":"وَاليْلِ وَمَا وَسَقَ ١٧","juz":30,"page":589},{"number":18,"text":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ ١٨","juz":30,"page":589},{"number":19,"text":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ ١٩","juz":30,"page":589},{"number":20,"text":"فَمَا لَهُمْ لَا يُومِنُونَ ٢٠","juz":30,"page":589},{"number":21,"text":" وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ ٢١","juz":30,"page":589},{"number":22,"text":"بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ ٢٢","juz":30,"page":589},{"number":23,"text":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ ٢٣","juz":30,"page":589},{"number":24,"text":"فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ ٢٤","juz":30,"page":589},{"number":25,"text":" اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ ٢٥","juz":30,"page":590}]}